// The C shim's functions (c/diskio_shim.c). Each may block on the disk; none allocates.

extern "C" {
    @effects(sleep)
    fn csf_open(path: *u8, length: usize, mode: i32) -> i64;
    // Closing a regular file on a local disk does not wait for the device, so drops may close in async code.
    @effects()
    fn csf_close(fd: i64);
    @effects(sleep)
    fn csf_pread(fd: i64, out: *mut u8, capacity: usize, offset: u64) -> i64;
    @effects(sleep)
    fn csf_write_all(fd: i64, bytes: *u8, length: usize) -> i64;
    @effects(sleep)
    fn csf_sync(fd: i64) -> i32;
    @effects(sleep)
    fn csf_size(fd: i64) -> i64;
    @effects(sleep)
    fn csf_rename(from: *u8, fromLength: usize, to: *u8, toLength: usize) -> i32;
    @effects(sleep)
    fn csf_remove(path: *u8, length: usize) -> i32;
    @effects(sleep)
    fn csf_exists(path: *u8, length: usize) -> i32;
    @effects(sleep)
    fn csf_make_dirs(path: *u8, length: usize) -> i32;
    @effects(sleep)
    fn csf_modified(path: *u8, length: usize) -> i64;
    @effects(sleep)
    fn csf_sync_dir(path: *u8, length: usize) -> i32;
    @effects()
    fn csf_errno_not_found() -> i32;
    @effects()
    fn csf_errno_exists() -> i32;
    @effects()
    fn csf_errno_denied() -> i32;
    @effects()
    fn csf_errno_no_space() -> i32;
}
