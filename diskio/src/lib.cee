// Files beyond lib/std's basic `File`: positioned reads, fsync, rename, mkdir -p and exclusive creation, for stores
// that must survive a crash (write to a temporary name, sync, rename, sync the directory).
//
// Since CeeSafe 0.21 this is plain CeeSafe over lib/std's `File` and `Directory` (CeeSafe ADR 0075 and ADR 0077): no
// C, and so no per-system sources and no errno constants. A new file gets mode 0640 and a new directory 0750, as the
// earlier C shim gave them, whatever the process's umask.
//
// Every call may block on the disk. Async code makes them through `Async.blocking`, so other tasks keep running.

/// Why a file operation failed.
public enum FileError {
    NotFound,
    Exists,
    Denied,
    NoSpace,
    /// Another error: the negative errno (EIO, -5, where lib/std reports a kind without one).
    Os(i32),
}

/// The FileError of a lib/std IoError.
fn errorOf(error: IoError) -> FileError => match (error) {
    IoError.NotFound => FileError.NotFound,
    IoError.AlreadyExists => FileError.Exists,
    IoError.PermissionDenied => FileError.Denied,
    IoError.StorageFull => FileError.NoSpace,
    IoError.InvalidInput => FileError.Os(-22),
    IoError.IsDirectory => FileError.Os(-21),
    IoError.NotDirectory => FileError.Os(-20),
    IoError.OutOfMemory => FileError.Os(-12),
    IoError.Other(code) => FileError.Os(0 - code),
    _ => FileError.Os(-5),
};

fn check(result: Result<void, IoError>) -> Result<void, FileError> => match (result) {
    Ok() => Ok(),
    Err(e) => Err(errorOf(e)),
};

/// Words for a `FileError`.
public fn describe(error: FileError) -> StringView {
    match (error) {
        FileError.NotFound => { return "no such file or directory"; }
        FileError.Exists => { return "the file exists"; }
        FileError.Denied => { return "permission denied"; }
        FileError.NoSpace => { return "no space left on the device"; }
        FileError.Os(_) => { return "file system error"; }
    }
}

/// The mode of a file diskio creates: the owner reads and writes, the group reads.
const FILE_MODE: u32 = 0o640;
/// The mode of a directory diskio creates.
const DIRECTORY_MODE: u32 = 0o750;

/// Whether anything is at `path`; a failed look is an error.
fn present(path: StringView) -> Result<bool, FileError> => match (File.kind(path)) {
    Ok(found) => Ok(found.isSome()),
    Err(e) => Err(errorOf(e)),
};

/// An open file. Its drop closes it, without waiting for the device.
@noncopy
public struct RawFile {
    private file: File;

    fn made(opened: Result<File, IoError>) -> Result<RawFile, FileError> => match (opened) {
        Ok(f) => Ok(RawFile { file: f }),
        Err(e) => Err(errorOf(e)),
    };

    /// Opens an existing file for reading.
    public fn open(path: StringView) -> Result<RawFile, FileError> => RawFile.made(File.open(path));

    /// Creates a new file for reading and writing; `FileError.Exists` if there is one already. It has mode 0640
    /// before a byte is written to it.
    public fn createNew(path: StringView) -> Result<RawFile, FileError> {
        let file = RawFile.made(File.createNew(path))?;
        check(File.setPermissions(path, FILE_MODE))?;
        return Ok(file);
    }

    /// Creates or truncates a file for reading and writing. A new one has mode 0640; an existing one keeps its own.
    public fn create(path: StringView) -> Result<RawFile, FileError> {
        let existed = present(path)?;
        let file = RawFile.made(File.openOrCreate(path))?;
        if (!existed) {
            check(File.setPermissions(path, FILE_MODE))?;
        }
        check(file.file.setLength(0))?;
        return Ok(file);
    }

    /// Opens or creates a file for appending: every write goes to its end. A new one has mode 0640.
    public fn append(path: StringView) -> Result<RawFile, FileError> {
        let existed = present(path)?;
        let file = RawFile.made(File.openAppend(path))?;
        if (!existed) {
            check(File.setPermissions(path, FILE_MODE))?;
        }
        return Ok(file);
    }

    /// Reads up to `out.length` bytes at `offset`, without moving any file position; 0 at the end.
    public fn readAt(borrow this, out: SliceMut<u8>, offset: u64) -> Result<usize, FileError> =>
        match (this.file.readAt(out, offset)) {
            Ok(n) => Ok(n),
            Err(e) => Err(errorOf(e)),
        };

    /// Reads exactly `out.length` bytes at `offset`; `NotFound` if the file ends first.
    public fn readExactAt(borrow this, out: SliceMut<u8>, offset: u64) -> Result<void, FileError> {
        var done: usize = 0;
        while (done < out.length) {
            let n = this.readAt(mut out[done..], offset + (done as u64))?;
            if (n == 0) {
                return Err(FileError.NotFound);
            }
            done += n;
        }
        return Ok();
    }

    /// Writes all of `bytes` at the file's position (at its end, for `append`).
    public fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, FileError> => check(this.file.write(bytes));

    /// Flushes the file's data and metadata to the device (fsync; F_FULLFSYNC on macOS, which also flushes the
    /// drive's own cache).
    public fn sync(borrow this) -> Result<void, FileError> => check(this.file.syncAll());

    /// The file's size in bytes.
    public fn size(borrow this) -> Result<u64, FileError> => match (this.file.length()) {
        Ok(n) => Ok(n),
        Err(e) => Err(errorOf(e)),
    };
}

/// Operations on paths.
public struct Files {
    /// Renames `from` to `to`, replacing `to` atomically if it exists.
    public fn rename(from: StringView, to: StringView) -> Result<void, FileError> => check(File.rename(from, to));

    /// Removes a file.
    public fn remove(path: StringView) -> Result<void, FileError> => check(File.remove(path));

    /// Whether anything exists at `path`.
    public fn exists(path: StringView) -> Result<bool, FileError> => present(path);

    /// Creates `path` and every missing parent directory (mkdir -p), each new one with mode 0750.
    public fn makeDirectories(path: StringView) -> Result<void, FileError> {
        let bytes = path.bytes();
        if (bytes.length == 0) {
            return Err(FileError.Os(-22));
        }
        var i: usize = 1;
        while (i <= bytes.length) {
            if (i == bytes.length || bytes[i] == '/') {
                // A prefix that ends before a '/', or at the end, is whole UTF-8.
                let part = StringView.fromUtf8(bytes[0..i]) ?? path;
                match (Directory.create(part)) {
                    Ok() => { check(File.setPermissions(part, DIRECTORY_MODE))?; }
                    Err(IoError.AlreadyExists) => {}
                    Err(e) => { return Err(errorOf(e)); }
                }
            }
            i += 1;
        }
        return match (File.kind(path)) {
            Ok(Some(PathKind.Directory)) => Ok(),
            Ok(_) => Err(FileError.Os(-20)),
            Err(e) => Err(errorOf(e)),
        };
    }

    /// When `path` was last modified, in Unix seconds.
    public fn modifiedSeconds(path: StringView) -> Result<i64, FileError> => match (File.modified(path)) {
        Ok(t) => Ok(t.seconds),
        Err(e) => Err(errorOf(e)),
    };

    /// Flushes a directory's entries to the device, so a rename or creation in it survives a crash.
    public fn syncDirectory(path: StringView) -> Result<void, FileError> => check(Directory.sync(path));
}
