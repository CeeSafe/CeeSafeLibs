// Loopback tests: a server and a client in one process, over 127.0.0.1, with the certificates in tests/fixtures
// (generated by tests/fixtures/generate.sh). They run natively only: the interpreter cannot call C.
//
// Each test loads its fixtures in sync code (file reads block) and runs one async scenario function with
// `Async.run(scenario(...))`. The scenario's scope is inside an async fn on purpose: with ceesafec 0.14.0,
// `Async.run(Async.scope(…))` written directly in sync code does not deliver the scope's result.

// ── Fixtures and small helpers ──────────────────────────────────────────────────────────────────────────────

/// The bytes of a fixture file. Test setup, so failure stops the test.
fn fixture(name: StringView) -> Vector<u8> {
    var path = String.create();
    path.append("tests/fixtures/")!;
    path.append(name)!;
    var file = File.open(path.view())!;
    var out = Vector<u8>.create();
    var buffer = [0u8; 4096];
    loop {
        let n = file.read(mut buffer[..])!;
        if (n == 0) {
            break;
        }
        for (i in 0..n) {
            out.push(buffer[i])!;
        }
    }
    return out;
}

/// A server configuration for the fixture pair `<name>.pem` and `<name>.key`.
fn serverConfig(name: StringView) -> TlsConfig {
    var cert = String.create();
    cert.append(name)!;
    cert.append(".pem")!;
    var key = String.create();
    key.append(name)!;
    key.append(".key")!;
    let chain = fixture(cert.view());
    let pkey = fixture(key.view());
    return TlsConfig.server(chain.view(), pkey.view())!;
}

/// A client trusting only the test CA.
fn testClient() -> TlsConfig {
    var config = TlsConfig.clientWithoutRoots()!;
    let ca = fixture("ca.pem");
    config.trustPem(ca.view())!;
    return config;
}

fn listen() -> AsyncTcpListener => AsyncTcpListener.bind("127.0.0.1", 0)!;

async fn acceptTcp(listener: borrow AsyncTcpListener) -> Result<AsyncTcpStream, TlsError> {
    match (await listener.accept()) {
        Ok(s) => { return Ok(s); }
        Err(e) => { return Err(TlsError.Io(e)); }
    }
}

async fn connectTcp(port: u16) -> Result<AsyncTcpStream, TlsError> {
    match (await AsyncTcpStream.connect("127.0.0.1", port)) {
        Ok(s) => { return Ok(s); }
        Err(e) => { return Err(TlsError.Io(e)); }
    }
}

/// Reads exactly `buffer.length` plain bytes from a TCP stream.
async fn readTcpExactly(tcp: borrow AsyncTcpStream, buffer: SliceMut<u8>) -> Result<void, TlsError> {
    var at: usize = 0;
    while (at < buffer.length) {
        let n = match (await tcp.read(mut buffer[at..])) {
            Ok(n) => n,
            Err(e) => { return Err(TlsError.Io(e)); }
        };
        if (n == 0) {
            return Err(TlsError.Truncated);
        }
        at += n;
    }
    return Ok();
}

async fn writeTcp(tcp: borrow AsyncTcpStream, bytes: Slice<u8>) -> Result<void, TlsError> {
    match (await tcp.write(bytes)) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(TlsError.Io(e)); }
    }
}

/// Reads exactly `buffer.length` decrypted bytes.
async fn readExactly(tls: borrow mut TlsStream, buffer: SliceMut<u8>) -> Result<void, TlsError> {
    var at: usize = 0;
    while (at < buffer.length) {
        let n = await tls.read(mut buffer[at..])?;
        if (n == 0) {
            return Err(TlsError.Truncated);
        }
        at += n;
    }
    return Ok();
}

struct Summary {
    count: u64;
    sum: u64;
}

/// Reads until the peer's close_notify, returning the byte count and a position-weighted checksum.
async fn drain(tls: borrow mut TlsStream) -> Result<Summary, TlsError> {
    var buffer = [0u8; 8192];
    var summary = Summary { count: 0, sum: 0 };
    loop {
        let n = await tls.read(mut buffer[..])?;
        if (n == 0) {
            return Ok(summary);
        }
        for (i in 0..n) {
            summary.sum = summary.sum.wrappingMul(31).wrappingAdd(buffer[i] as u64);
        }
        summary.count += n as u64;
    }
}

fn pattern(n: usize) -> Vector<u8> {
    var v = Vector<u8>.withCapacity(n)!;
    for (i in 0..n) {
        v.push(truncate<u8>(i * 7 + i / 251))!;
    }
    return v;
}

fn checksum(bytes: Slice<u8>) -> u64 {
    var sum: u64 = 0;
    for (b in bytes) {
        sum = sum.wrappingMul(31).wrappingAdd(b as u64);
    }
    return sum;
}

fn writeU64(out: SliceMut<u8>, at: usize, v: u64) {
    for (i in 0..8) {
        out[at + i] = truncate<u8>(v >> ((7 - i) as u64 * 8));
    }
}

fn readU64(bytes: Slice<u8>, at: usize) -> u64 {
    var v: u64 = 0;
    for (i in 0..8) {
        v = (v << 8) | (bytes[at + i] as u64);
    }
    return v;
}

/// Passes when `r` is `Ok`; otherwise prints the error's words and fails with `what`.
fn expectOk(r: borrow Result<void, TlsError>, what: StringView) -> Result<void, TestFailure> {
    match (r) {
        Ok() => { return Ok(); }
        Err(e) => {
            var words = [0u8; 256];
            let n = TlsErrors.describe(e, mut words[..]);
            Console.writeError("tls error: ");
            match (StringView.fromUtf8(words[0..n])) {
                Some(text) => { Console.writeErrorLine(text); }
                null => { Console.writeErrorLine("(not UTF-8)"); }
            }
            return Check.fail(what);
        }
    }
}

fn isVerifyError(r: borrow Result<void, TlsError>) -> bool => match (r) {
    Err(TlsError.Verify(_)) => true,
    _ => false,
};

// ── A large round trip ──────────────────────────────────────────────────────────────────────────────────────

/// What the client of the round trip observed.
struct RoundTrip {
    reply: [u8; 17];
    version: u16;
    peerCertificate: bool;
}

/// Server side: reads everything the client sends, then answers with its count, checksum and the SNI length.
async fn summarize(listener: borrow AsyncTcpListener, config: borrow TlsConfig) -> Result<void, TlsError> {
    let tcp = await acceptTcp(listener)?;
    var tls = await TlsStream.accept(tcp, config)?;
    var name = [0u8; 64];
    let nameLength = tls.serverName(mut name[..]);
    let got = await drain(mut tls)?;
    var reply = [0u8; 17];
    writeU64(mut reply[..], 0, got.count);
    writeU64(mut reply[..], 8, got.sum);
    reply[16] = truncate<u8>(nameLength);
    await tls.write(reply[..])?;
    await tls.shutdown()?;
    return Ok();
}

/// Client side: sends `payload`, closes its half, reads the summary and then the server's close_notify.
async fn sendAndSummarize(
    port: u16,
    config: borrow TlsConfig,
    payload: Slice<u8>,
    seen: borrow mut RoundTrip,
) -> Result<void, TlsError> {
    let tcp = await connectTcp(port)?;
    var tls = await TlsStream.connect(tcp, config, "localhost")?;
    seen.version = tls.version();
    seen.peerCertificate = tls.hasPeerCertificate();
    await tls.write(payload)?;
    await tls.shutdown()?;
    var reply = [0u8; 17];
    await readExactly(mut tls, mut reply[..])?;
    seen.reply = reply;
    var one = [0u8; 1];
    if (await tls.read(mut one[..])? != 0) {
        return Err(TlsError.Config); // expected the end of the session
    }
    return Ok();
}

async fn roundTrip(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    payload: Slice<u8>,
    seen: borrow mut RoundTrip,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await summarize(listener, server));
        s.spawn(async () => await sendAndSummarize(port, client, payload, mut seen));
    })?;
    return Ok();
}

@test
fn roundTripLargePayload() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    let payload = pattern(3 * 1024 * 1024 + 17);
    var seen = RoundTrip { reply: [0u8; 17], version: 0, peerCertificate: false };
    let outcome = Async.run(roundTrip(server, client, payload.view(), mut seen));
    expectOk(borrow outcome, "the exchange succeeds")?;
    let reply = seen.reply;
    Check.equalU64(payload.length as u64, readU64(reply[..], 0))?;
    Check.equalU64(checksum(payload.view()), readU64(reply[..], 8))?;
    Check.equalU64(9, reply[16] as u64)?; // the server saw SNI "localhost"
    Check.equalU64(0x0304, seen.version as u64)?;
    return Check.isTrue(seen.peerCertificate, "the server presented a certificate");
}

// ── Verification, SNI ───────────────────────────────────────────────────────────────────────────────────────

/// Accepts one connection and ignores how its handshake ends: for tests where the client is meant to fail.
async fn acceptAndIgnore(listener: borrow AsyncTcpListener, config: borrow TlsConfig) -> Result<void, TlsError> {
    let tcp = await acceptTcp(listener)?;
    match (await TlsStream.accept(tcp, config)) {
        Ok(tls) => {
            var t = tls;
            var buffer = [0u8; 16];
            match (await t.read(mut buffer[..])) {
                Ok(_) => {}
                Err(_) => {}
            }
        }
        Err(_) => {}
    }
    return Ok();
}

async fn connectNamed(port: u16, client: borrow TlsConfig, name: StringView) -> Result<void, TlsError> {
    let tcp = await connectTcp(port)?;
    var tls = await TlsStream.connect(tcp, client, name)?;
    await tls.shutdown()?;
    return Ok();
}

/// Handshakes as a client naming `name`, storing how it ended in `result`.
async fn handshakeScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    name: StringView,
    result: borrow mut Result<void, TlsError>,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await acceptAndIgnore(listener, server));
        s.spawn(async () => {
            result = await connectNamed(port, client, name);
            return Ok();
        });
    })?;
    return Ok();
}

/// How a client handshake naming `name` ends.
fn handshakeWith(server: borrow TlsConfig, client: borrow TlsConfig, name: StringView) -> Result<void, TlsError> {
    var result: Result<void, TlsError> = Err(TlsError.Closed);
    match (Async.run(handshakeScenario(server, client, name, mut result))) {
        Ok() => { return result; }
        Err(e) => { return Err(e); }
    }
}

@test
fn rejectsUntrustedServer() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    var client = TlsConfig.clientWithoutRoots()!;
    let other = fixture("otherca.pem");
    client.trustPem(other.view())!;
    let r = handshakeWith(server, client, "localhost");
    return Check.isTrue(isVerifyError(borrow r), "a chain from an untrusted CA fails verification");
}

@test
fn rejectsWrongHostName() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    let r = handshakeWith(server, client, "mail.example.org");
    return Check.isTrue(isVerifyError(borrow r), "a certificate for another name fails verification");
}

@test
fn verifiesIpAddress() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    let r = handshakeWith(server, client, "127.0.0.1");
    return expectOk(borrow r, "the certificate's IP SAN matches");
}

@test
fn selectsCertificateBySni() -> Result<void, TestFailure> {
    var server = serverConfig("localhost");
    let a = serverConfig("a");
    let b = serverConfig("b");
    let wild = serverConfig("wild");
    server.addServerName("a.test", a)!;
    server.addServerName("B.TEST", b)!; // names compare without case
    server.addServerName("*.wild.test", wild)!;
    let client = testClient();
    let ra = handshakeWith(server, client, "a.test");
    expectOk(borrow ra, "a.test gets its own certificate")?;
    let rb = handshakeWith(server, client, "b.test");
    expectOk(borrow rb, "b.test gets its own certificate")?;
    let rw = handshakeWith(server, client, "imap.wild.test");
    expectOk(borrow rw, "a wildcard covers one label")?;
    let rdeep = handshakeWith(server, client, "x.imap.wild.test");
    Check.isTrue(isVerifyError(borrow rdeep), "a wildcard does not cover two labels")?;
    let rdefault = handshakeWith(server, client, "localhost");
    return expectOk(borrow rdefault, "other names get the default certificate");
}

// ── ALPN ────────────────────────────────────────────────────────────────────────────────────────────────────

struct Agreed {
    server: [u8; 16];
    serverLength: usize;
    client: [u8; 16];
    clientLength: usize;
}

async fn alpnScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    seen: borrow mut Agreed,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    var serverSide = [0u8; 16];
    var serverLength: usize = 0;
    var clientSide = [0u8; 16];
    var clientLength: usize = 0;
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => {
            let tcp = await acceptTcp(listener)?;
            var tls = await TlsStream.accept(tcp, server)?;
            serverLength = tls.alpn(mut serverSide[..]);
            await drain(mut tls)?;
            return Ok();
        });
        s.spawn(async () => {
            let tcp = await connectTcp(port)?;
            var tls = await TlsStream.connect(tcp, client, "localhost")?;
            clientLength = tls.alpn(mut clientSide[..]);
            await tls.shutdown()?;
            return Ok();
        });
    })?;
    seen.server = serverSide;
    seen.serverLength = serverLength;
    seen.client = clientSide;
    seen.clientLength = clientLength;
    return Ok();
}

@test
fn negotiatesAlpn() -> Result<void, TestFailure> {
    var server = serverConfig("localhost");
    let serverProtocols = ["imap", "h2"];
    server.alpn(serverProtocols[..])!;
    var client = testClient();
    let clientProtocols = ["h2", "http/1.1"];
    client.alpn(clientProtocols[..])!;
    var seen = Agreed { server: [0u8; 16], serverLength: 0, client: [0u8; 16], clientLength: 0 };
    let outcome = Async.run(alpnScenario(server, client, mut seen));
    expectOk(borrow outcome, "the handshake succeeds")?;
    let h2 = "h2";
    let s = seen.server;
    let c = seen.client;
    Check.equalBytes(h2.bytes(), s[0..seen.serverLength])?;
    return Check.equalBytes(h2.bytes(), c[0..seen.clientLength]);
}

// ── STARTTLS ────────────────────────────────────────────────────────────────────────────────────────────────

async fn startTlsServer(
    listener: borrow AsyncTcpListener,
    config: borrow TlsConfig,
    secret: borrow mut [u8; 6],
) -> Result<void, TlsError> {
    let tcp = await acceptTcp(listener)?;
    var command = [0u8; 10];
    await readTcpExactly(tcp, mut command[..])?; // "STARTTLS\r\n" in the clear
    let ready = "220 ready\r\n";
    await writeTcp(tcp, ready.bytes())?;
    var tls = await TlsStream.accept(tcp, config)?;
    var got = [0u8; 6];
    await readExactly(mut tls, mut got[..])?;
    secret = got;
    return Ok();
}

async fn startTlsClient(port: u16, config: borrow TlsConfig) -> Result<void, TlsError> {
    let tcp = await connectTcp(port)?;
    let command = "STARTTLS\r\n";
    await writeTcp(tcp, command.bytes())?;
    var answer = [0u8; 11];
    await readTcpExactly(tcp, mut answer[..])?;
    var tls = await TlsStream.connect(tcp, config, "localhost")?;
    let message = "secret";
    await tls.write(message.bytes())?;
    await tls.shutdown()?;
    return Ok();
}

async fn startTlsScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    secret: borrow mut [u8; 6],
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await startTlsServer(listener, server, mut secret));
        s.spawn(async () => await startTlsClient(port, client));
    })?;
    return Ok();
}

@test
fn upgradesWithStartTls() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    var secret = [0u8; 6];
    let outcome = Async.run(startTlsScenario(server, client, mut secret));
    expectOk(borrow outcome, "the upgraded session works")?;
    let expected = "secret";
    return Check.equalBytes(expected.bytes(), secret[..]);
}

// ── Hot reload ──────────────────────────────────────────────────────────────────────────────────────────────

/// Accepts two connections with the configuration current at each accept, switching to `next` after the first.
async fn acceptReloading(
    listener: borrow AsyncTcpListener,
    shared: borrow SharedTlsConfig,
    next: borrow TlsConfig,
) -> Result<void, TlsError> {
    for (i in 0..2) {
        let tcp = await acceptTcp(listener)?;
        let current = shared.current();
        match (await TlsStream.accept(tcp, current)) {
            Ok(tls) => {
                var t = tls;
                match (await drain(mut t)) {
                    Ok(_) => {}
                    Err(_) => {}
                }
            }
            Err(_) => {}
        }
        if (i == 0) {
            shared.replace(next.clone())?;
        }
    }
    return Ok();
}

async fn reloadScenario(
    shared: borrow SharedTlsConfig,
    next: borrow TlsConfig,
    client: borrow TlsConfig,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await acceptReloading(listener, shared, next));
        s.spawn(async () => {
            await connectNamed(port, client, "a.test")?; // before the reload: a's certificate
            await connectNamed(port, client, "b.test")?; // after it: b's
            return Ok();
        });
    })?;
    return Ok();
}

@test
fn reloadsCertificate() -> Result<void, TestFailure> {
    let shared = SharedTlsConfig.create(serverConfig("a"))!;
    let next = serverConfig("b");
    let client = testClient();
    let outcome = Async.run(reloadScenario(shared, next, client));
    return expectOk(borrow outcome, "each connection sees the certificate current then");
}

// ── Client certificates ─────────────────────────────────────────────────────────────────────────────────────

/// What a mutual-TLS attempt looked like from both ends.
struct Mutual {
    refused: bool;
    serverSawCertificate: bool;
}

async fn echoOneByte(
    listener: borrow AsyncTcpListener,
    config: borrow TlsConfig,
    seen: borrow mut Mutual,
) -> Result<void, TlsError> {
    let tcp = await acceptTcp(listener)?;
    match (await TlsStream.accept(tcp, config)) {
        Ok(tls) => {
            var t = tls;
            seen.serverSawCertificate = t.hasPeerCertificate();
            var one = [0u8; 1];
            if (await t.read(mut one[..])? == 1) {
                await t.write(one[..])?;
            }
            await t.shutdown()?;
        }
        Err(_) => {}
    }
    return Ok();
}

/// Whether the client is refused: in TLS 1.3 a client learns of a refused certificate on its first read after the
/// handshake, so it sends a byte and waits for the echo.
async fn pingRefused(port: u16, config: borrow TlsConfig) -> Result<bool, TlsError> {
    let tcp = await connectTcp(port)?;
    match (await TlsStream.connect(tcp, config, "localhost")) {
        Ok(tls) => {
            var t = tls;
            let ping = "x";
            match (await t.write(ping.bytes())) {
                Ok() => {}
                Err(_) => { return Ok(true); }
            }
            var one = [0u8; 1];
            match (await t.read(mut one[..])) {
                Ok(n) => { return Ok(n != 1); }
                Err(_) => { return Ok(true); }
            }
        }
        Err(_) => { return Ok(true); }
    }
}

async fn mutualScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    seen: borrow mut Mutual,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    var refused = false;
    var sawCertificate = Mutual { refused: false, serverSawCertificate: false };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await echoOneByte(listener, server, mut sawCertificate));
        s.spawn(async () => {
            refused = await pingRefused(port, client)?;
            return Ok();
        });
    })?;
    seen.refused = refused;
    seen.serverSawCertificate = sawCertificate.serverSawCertificate;
    return Ok();
}

@test
fn requiresClientCertificate() -> Result<void, TestFailure> {
    var server = serverConfig("localhost");
    server.verifyPeer(true);
    let ca = fixture("ca.pem");
    server.trustPem(ca.view())!;

    let anonymous = testClient();
    var first = Mutual { refused: false, serverSawCertificate: false };
    let r1 = Async.run(mutualScenario(server, anonymous, mut first));
    expectOk(borrow r1, "the anonymous attempt runs")?;
    Check.isTrue(first.refused, "a client without a certificate is refused")?;

    var withCert = testClient();
    let cert = fixture("client.pem");
    let key = fixture("client.key");
    withCert.useCertificate(cert.view(), key.view())!;
    var second = Mutual { refused: false, serverSawCertificate: false };
    let r2 = Async.run(mutualScenario(server, withCert, mut second));
    expectOk(borrow r2, "the attempt with a certificate runs")?;
    Check.isTrue(!second.refused, "a client with a certificate from the trusted CA is accepted")?;
    return Check.isTrue(second.serverSawCertificate, "the server sees the client's certificate");
}

// ── Configuration errors, truncation ────────────────────────────────────────────────────────────────────────

@test
fn reportsBadPem() -> Result<void, TestFailure> {
    let junk = "not a certificate";
    let key = fixture("localhost.key");
    let badChain = TlsConfig.server(junk.bytes(), key.view());
    let isCertError = match (badChain) {
        Err(TlsError.Certificate) => true,
        _ => false,
    };
    Check.isTrue(isCertError, "garbage instead of a chain is a certificate error")?;
    let chain = fixture("localhost.pem");
    let otherKey = fixture("a.key");
    let mismatch = TlsConfig.server(chain.view(), otherKey.view());
    let isMismatch = match (mismatch) {
        Err(TlsError.KeyMismatch) => true,
        _ => false,
    };
    Check.isTrue(isMismatch, "another certificate's key is a mismatch")?;
    var description = [0u8; 128];
    let n = TlsErrors.describe(TlsError.KeyMismatch, mut description[..]);
    return Check.isTrue(n > 0, "errors have words");
}

async fn truncationScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    truncated: borrow mut bool,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    var sawTruncation = false;
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => {
            let tcp = await acceptTcp(listener)?;
            let tls = await TlsStream.accept(tcp, server)?;
            return Ok(); // `tls` is dropped: the socket closes with no close_notify
        });
        s.spawn(async () => {
            let tcp = await connectTcp(port)?;
            var tls = await TlsStream.connect(tcp, client, "localhost")?;
            var buffer = [0u8; 16];
            match (await tls.read(mut buffer[..])) {
                Err(TlsError.Truncated) => { sawTruncation = true; }
                _ => {}
            }
            return Ok();
        });
    })?;
    truncated = sawTruncation;
    return Ok();
}

@test
fn reportsTruncation() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    var truncated = false;
    let outcome = Async.run(truncationScenario(server, client, mut truncated));
    expectOk(borrow outcome, "both sides finish")?;
    return Check.isTrue(truncated, "a TCP close without close_notify is Truncated");
}

// ── DANE ────────────────────────────────────────────────────────────────────────────────────────────────────
// The digests and the CA's key are from the openssl command line (tests/fixtures):
//   x509 -in localhost.pem -noout -pubkey | pkey -pubin -outform DER | dgst -sha256   (localhost's SPKI)
//   x509 -in localhost.pem -outform DER | dgst -sha256                                   (localhost's certificate)
//   x509 -in ca.pem -noout -pubkey | pkey -pubin -outform DER                            (the CA's SPKI)

const LOCALHOST_SPKI_SHA256: StringView = "d03a94b2dc22beb9f94f9b0db6d7ecc9631f875c0db547d508250f4d948faf29";
const LOCALHOST_CERT_SHA256: StringView = "db90fed6c50d042cf1e49fedc421ff616209f3bcbd53a2bd895d47576cc8d531";
const CA_SPKI: StringView =
    "3059301306072a8648ce3d020106082a8648ce3d03010703420004351a7aa1599c7de2f723b37082fc7939656e2c283ae56250d418d9ed8327099de7270cf24db2bd5000376c34a430f9d26d9b39fe8db63a39cc1a8611394e354a";

fn hexValue(c: u8) -> u8 {
    if (c >= 0x30 && c <= 0x39) {
        return c - 0x30;
    }
    return c - 0x61 + 10;
}

/// A TLSA record from its fields and hex data.
fn tlsa(usage: u8, selector: u8, matching: u8, hex: StringView) -> Tlsa {
    var data = Vector<u8>.create();
    let b = hex.bytes();
    var i: usize = 0;
    while (i + 1 < b.length) {
        data.push(hexValue(b[i]) * 16 + hexValue(b[i + 1]))!;
        i += 2;
    }
    return Tlsa { usage: usage, selector: selector, matching: matching, data: data };
}

fn daneClient() -> TlsConfig {
    var client = TlsConfig.clientWithoutRoots()!;
    client.enableDane()!;
    return client;
}

async fn connectDane(
    port: u16,
    client: borrow TlsConfig,
    name: StringView,
    records: borrow Vector<Tlsa>,
    depth: borrow mut i32,
) -> Result<void, TlsError> {
    let tcp = await connectTcp(port)?;
    var tls = await TlsStream.connectDaneWithin(tcp, client, name, records, 5000)?;
    depth = tls.daneDepth();
    await tls.shutdown()?;
    return Ok();
}

async fn daneScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    name: StringView,
    records: borrow Vector<Tlsa>,
    result: borrow mut Result<void, TlsError>,
    depth: borrow mut i32,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await acceptAndIgnore(listener, server));
        s.spawn(async () => {
            result = await connectDane(port, client, name, records, mut depth);
            return Ok();
        });
    })?;
    return Ok();
}

/// How a DANE handshake naming `name` with `records` ends, and the matched depth.
fn daneWith(name: StringView, records: borrow Vector<Tlsa>, depth: borrow mut i32) -> Result<void, TlsError> {
    let server = serverConfig("localhost");
    let client = daneClient();
    var result: Result<void, TlsError> = Err(TlsError.Closed);
    match (Async.run(daneScenario(server, client, name, records, mut result, mut depth))) {
        Ok() => { return result; }
        Err(e) => { return Err(e); }
    }
}

@test
fn daneEeMatchesKeyAndCertificate() -> Result<void, TestFailure> {
    var records = Vector<Tlsa>.create();
    records.push(tlsa(3, 1, 1, LOCALHOST_SPKI_SHA256))!;
    var depth: i32 = -2;
    let r = daneWith("localhost", records, mut depth);
    expectOk(borrow r, "DANE-EE 3 1 1 of the server's key")?;
    Check.isTrue(depth == 0, "the server's own certificate matched")?;
    var byCert = Vector<Tlsa>.create();
    byCert.push(tlsa(3, 0, 1, LOCALHOST_CERT_SHA256))!;
    let c = daneWith("localhost", byCert, mut depth);
    return expectOk(borrow c, "DANE-EE 3 0 1 of the server's certificate");
}

@test
fn daneEeSkipsNameChecks() -> Result<void, TestFailure> {
    var records = Vector<Tlsa>.create();
    records.push(tlsa(3, 1, 1, LOCALHOST_SPKI_SHA256))!;
    var depth: i32 = -2;
    let r = daneWith("mx.other.example", records, mut depth);
    return expectOk(borrow r, "DANE-EE ignores the certificate's names (RFC 7672 §3.1.1)");
}

@test
fn daneRejectsAMismatch() -> Result<void, TestFailure> {
    var records = Vector<Tlsa>.create();
    records.push(tlsa(3, 1, 1, LOCALHOST_CERT_SHA256))!; // a digest of something else
    var depth: i32 = -2;
    let r = daneWith("localhost", records, mut depth);
    return Check.isTrue(isVerifyError(borrow r), "no record matches: Verify");
}

@test
fn daneTaChecksTheName() -> Result<void, TestFailure> {
    var records = Vector<Tlsa>.create();
    records.push(tlsa(2, 1, 0, CA_SPKI))!;
    var depth: i32 = -2;
    let r = daneWith("localhost", records, mut depth);
    expectOk(borrow r, "DANE-TA 2 1 0 of the issuing CA's key")?;
    // A bare trust-anchor key gives the depth of the certificate it signed: here the server's own.
    Check.isTrue(depth == 0, "DANE authenticated the server through its issuer's key")?;
    var again = Vector<Tlsa>.create();
    again.push(tlsa(2, 1, 0, CA_SPKI))!;
    let wrong = daneWith("mail.example.org", again, mut depth);
    return Check.isTrue(isVerifyError(borrow wrong), "DANE-TA still checks the name");
}

@test
fn daneNeedsAUsableRecord() -> Result<void, TestFailure> {
    var records = Vector<Tlsa>.create();
    records.push(tlsa(3, 1, 1, "abcd"))!; // a SHA-256 of the wrong length
    Check.isTrue(!records[0].usableForSmtp(), "a short digest is unusable")?;
    var depth: i32 = -2;
    let r = daneWith("localhost", records, mut depth);
    return Check.isTrue(
        match (r) {
            Err(TlsError.Config) => true,
            _ => false,
        },
        "no usable record: Config",
    );
}

// ── A read that times out ───────────────────────────────────────────────────────────────────────────────────

/// Server: waits, then sends "late" and closes.
async fn speakLate(listener: borrow AsyncTcpListener, config: borrow TlsConfig) -> Result<void, TlsError> {
    let tcp = await acceptTcp(listener)?;
    var tls = await TlsStream.accept(tcp, config)?;
    match (await Timer.sleep(300)) {
        Ok() => {}
        Err(e) => { return Err(TlsError.Io(e)); }
    }
    await tls.write("late".bytes())?;
    await tls.shutdown()?;
    return Ok();
}

/// Client: a read that times out while the server is silent, then a read on the same session that gets "late".
async fn readAfterTimeout(
    port: u16,
    config: borrow TlsConfig,
    timedOut: borrow mut bool,
    got: borrow mut Vector<u8>,
) -> Result<void, TlsError> {
    let tcp = await connectTcp(port)?;
    var tls = await TlsStream.connect(tcp, config, "localhost")?;
    var buffer = [0u8; 16];
    let first: Result<usize, TlsError> = await Async.timeout(
        50,
        TlsError.Io(AsyncError.TimedOut),
        async () => await tls.read(mut buffer[..]),
    );
    timedOut = match (first) {
        Err(TlsError.Io(AsyncError.TimedOut)) => true,
        _ => false,
    };
    let n = await tls.read(mut buffer[..])?;
    match (got.extend(buffer[0..n])) {
        Ok() => {}
        Err(_) => { return Err(TlsError.OutOfMemory); }
    }
    return Ok();
}

async fn timeoutScenario(
    server: borrow TlsConfig,
    client: borrow TlsConfig,
    timedOut: borrow mut bool,
    got: borrow mut Vector<u8>,
    result: borrow mut Result<void, TlsError>,
) -> Result<void, TlsError> {
    let listener = listen();
    let port = match (listener.port()) {
        Ok(p) => p,
        Err(_) => { return Err(TlsError.Config); }
    };
    await Async.scope(TlsError.OutOfMemory, (s) => {
        s.spawn(async () => await speakLate(listener, server));
        s.spawn(async () => {
            result = await readAfterTimeout(port, client, mut timedOut, mut got);
            return Ok();
        });
    })?;
    return Ok();
}

@test
fn readsAgainAfterATimeout() -> Result<void, TestFailure> {
    let server = serverConfig("localhost");
    let client = testClient();
    var timedOut = false;
    var got = Vector<u8>.create();
    var result: Result<void, TlsError> = Err(TlsError.Closed);
    let outcome = Async.run(timeoutScenario(server, client, mut timedOut, mut got, mut result));
    expectOk(borrow outcome, "the scenario runs")?;
    expectOk(borrow result, "the second read succeeds")?;
    Check.isTrue(timedOut, "the first read timed out while the server was silent")?;
    return Check.isTrue(got.view() == "late".bytes(), "and the session still reads what comes next");
}
