// The package's bridge to OpenSSL 3, in CeeSafe: OpenSSL's functions declared directly, and the `cstls_*` functions
// the rest of the package calls, which were a C shim (c/tls_shim.c) until 2026-11. None of them sleeps: connections
// work on two memory BIOs, so OpenSSL never touches a socket, and they may be called from async code.
//
// No OpenSSL header is included: the prototypes below are generated as declared, with C's `long` and `unsigned long`
// as 64-bit integers (LP64: macOS and Linux) and OpenSSL's opaque types as `void *`. What OpenSSL defines as macros is
// written out as the call it expands to (`SSL_CTX_ctrl`, `SSL_ctrl`, `BIO_ctrl`, `SSL_CTX_callback_ctrl`), with the
// command numbers of OpenSSL 3's headers. Callbacks (ALPN and SNI selection, and freeing a context's extras) are
// `@callback` functions.

// Declared once, in pkey (C names are global): the calls both packages make.
import pkey.BIO_free;
import pkey.BIO_new_mem_buf;
import pkey.EVP_PKEY_free;
import pkey.PEM_read_bio_PrivateKey;

extern "C" {
    @effects(alloc)
    fn OPENSSL_init_ssl(opts: u64, settings: *void) -> i32;
    @effects()
    fn TLS_server_method() -> *void;
    @effects()
    fn TLS_client_method() -> *void;

    @effects(alloc)
    fn SSL_CTX_new(method: *void) -> *mut void;
    @effects()
    fn SSL_CTX_up_ref(ctx: *mut void) -> i32;
    @effects()
    fn SSL_CTX_free(ctx: *mut void);
    @effects(alloc)
    fn SSL_CTX_ctrl(ctx: *mut void, cmd: i32, larg: i64, parg: *mut void) -> i64;
    @effects()
    fn SSL_CTX_callback_ctrl(
        ctx: *mut void,
        cmd: i32,
        callback: extern "C" fn(*mut void, *mut i32, *mut void) -> i32,
    ) -> i64;
    @effects()
    fn SSL_CTX_set_options(ctx: *mut void, options: u64) -> u64;
    @effects()
    fn SSL_CTX_set_session_id_context(ctx: *mut void, sid: *u8, length: u32) -> i32;
    @effects()
    fn SSL_CTX_set_verify(ctx: *mut void, mode: i32, callback: *void);
    @effects()
    fn SSL_CTX_get_ssl_method(ctx: *mut void) -> *void;
    @effects(alloc)
    fn SSL_CTX_use_certificate(ctx: *mut void, x509: *mut void) -> i32;
    @effects()
    fn SSL_CTX_get0_certificate(ctx: *mut void) -> *mut void;
    @effects(alloc)
    fn SSL_CTX_use_PrivateKey(ctx: *mut void, key: *mut void) -> i32;
    @effects(alloc)
    fn SSL_CTX_set_default_verify_paths(ctx: *mut void) -> i32;
    @effects()
    fn SSL_CTX_get_cert_store(ctx: *mut void) -> *mut void;
    @effects(alloc)
    fn SSL_CTX_set_alpn_protos(ctx: *mut void, protos: *u8, length: u32) -> i32;
    @effects()
    fn SSL_CTX_set_alpn_select_cb(
        ctx: *mut void,
        callback: extern "C" fn(*mut void, *mut *u8, *mut u8, *u8, u32, *mut void) -> i32,
        arg: *mut void,
    );
    @effects()
    fn SSL_CTX_get_ex_data(ctx: *mut void, index: i32) -> *mut void;
    @effects(alloc)
    fn SSL_CTX_set_ex_data(ctx: *mut void, index: i32, data: *mut void) -> i32;
    @effects()
    fn SSL_CTX_dane_enable(ctx: *mut void) -> i32;
    @effects(alloc)
    fn CRYPTO_get_ex_new_index(
        classIndex: i32,
        argl: i64,
        argp: *mut void,
        newFunction: *void,
        dupFunction: *void,
        freeFunction: extern "C" fn(*mut void, *mut void, *mut void, i32, i64, *mut void),
    ) -> i32;

    @effects(alloc)
    fn SSL_new(ctx: *mut void) -> *mut void;
    @effects()
    fn SSL_free(ssl: *mut void);
    @effects()
    fn SSL_set_bio(ssl: *mut void, readBio: *mut void, writeBio: *mut void);
    @effects()
    fn SSL_set_accept_state(ssl: *mut void);
    @effects()
    fn SSL_set_connect_state(ssl: *mut void);
    @effects(alloc)
    fn SSL_ctrl(ssl: *mut void, cmd: i32, larg: i64, parg: *mut void) -> i64;
    @effects()
    fn SSL_get0_param(ssl: *mut void) -> *mut void;
    @effects(alloc)
    fn X509_VERIFY_PARAM_set1_ip_asc(param: *mut void, ip: *CChar) -> i32;
    @effects(alloc)
    fn SSL_set1_host(ssl: *mut void, host: *CChar) -> i32;
    @effects(alloc)
    fn SSL_do_handshake(ssl: *mut void) -> i32;
    @effects()
    fn SSL_get_error(ssl: *mut void, ret: i32) -> i32;
    @effects(alloc)
    fn SSL_read_ex(ssl: *mut void, out: *mut void, capacity: usize, read: *mut usize) -> i32;
    @effects(alloc)
    fn SSL_write_ex(ssl: *mut void, bytes: *void, length: usize, written: *mut usize) -> i32;
    @effects(alloc)
    fn SSL_shutdown(ssl: *mut void) -> i32;
    @effects()
    fn SSL_version(ssl: *mut void) -> i32;
    @effects()
    fn SSL_get0_alpn_selected(ssl: *mut void, data: *mut *u8, length: *mut u32);
    @effects()
    fn SSL_get_servername(ssl: *mut void, kind: i32) -> *CChar;
    @effects()
    fn SSL_set_SSL_CTX(ssl: *mut void, ctx: *mut void) -> *mut void;
    @effects()
    fn SSL_get_verify_result(ssl: *mut void) -> i64;
    @effects()
    fn SSL_get0_peer_certificate(ssl: *mut void) -> *mut void;
    @effects()
    fn SSL_select_next_proto(
        out: *mut *mut u8,
        outLength: *mut u8,
        server: *u8,
        serverLength: u32,
        client: *u8,
        clientLength: u32,
    ) -> i32;
    @effects(alloc)
    fn SSL_dane_enable(ssl: *mut void, base: *CChar) -> i32;
    @effects()
    fn SSL_dane_set_flags(ssl: *mut void, flags: u64) -> u64;
    @effects()
    fn SSL_set_verify(ssl: *mut void, mode: i32, callback: *void);
    @effects(alloc)
    fn SSL_dane_tlsa_add(ssl: *mut void, usage: u8, selector: u8, matching: u8, data: *u8, length: usize) -> i32;
    @effects()
    fn SSL_get0_dane_authority(ssl: *mut void, certificate: *mut void, publicKey: *mut void) -> i32;

    @effects(alloc)
    fn BIO_new(method: *void) -> *mut void;
    @effects()
    fn BIO_s_mem() -> *void;
    @effects()
    fn BIO_ctrl(bio: *mut void, cmd: i32, larg: i64, parg: *mut void) -> i64;
    @effects()
    fn BIO_ctrl_pending(bio: *mut void) -> usize;
    @effects(alloc)
    fn BIO_write(bio: *mut void, bytes: *void, length: i32) -> i32;
    @effects()
    fn BIO_read(bio: *mut void, out: *mut void, capacity: i32) -> i32;

    @effects(alloc)
    fn PEM_read_bio_X509_AUX(bio: *mut void, x509: *mut void, callback: *void, arg: *mut void) -> *mut void;
    @effects(alloc)
    fn PEM_read_bio_X509(bio: *mut void, x509: *mut void, callback: *void, arg: *mut void) -> *mut void;
    @effects()
    fn X509_free(x509: *mut void);
    @effects()
    fn X509_check_private_key(x509: *mut void, key: *mut void) -> i32;
    @effects(alloc)
    fn X509_STORE_add_cert(store: *mut void, x509: *mut void) -> i32;
    @effects()
    fn X509_verify_cert_error_string(code: i64) -> *CChar;

    @effects()
    fn ERR_clear_error();
    @effects()
    fn ERR_get_error() -> u64;
    @effects()
    fn ERR_peek_last_error() -> u64;
    @effects()
    fn ERR_error_string_n(code: u64, out: *mut CChar, capacity: usize);
}

// Result codes of the configuration functions.
const CSTLS_OK: i32 = 0;
const CSTLS_ERR_CERT: i32 = -1;
const CSTLS_ERR_KEY: i32 = -2;
const CSTLS_ERR_KEY_MISMATCH: i32 = -3;
const CSTLS_ERR_NOMEM: i32 = -4;
const CSTLS_ERR_TRUST: i32 = -5;
const CSTLS_ERR_CONFIG: i32 = -6;

// OpenSSL 3's constants (ssl.h, tls1.h, bio.h, crypto.h, err.h, pemerr.h, prov_ssl.h).
const SSL_CTRL_MODE: i32 = 33;
const SSL_CTRL_SET_TLSEXT_SERVERNAME_CB: i32 = 53;
const SSL_CTRL_SET_TLSEXT_SERVERNAME_ARG: i32 = 54;
const SSL_CTRL_SET_TLSEXT_HOSTNAME: i32 = 55;
const SSL_CTRL_CHAIN: i32 = 88;
const SSL_CTRL_CHAIN_CERT: i32 = 89;
const SSL_CTRL_SET_MIN_PROTO_VERSION: i32 = 123;
const BIO_C_SET_BUF_MEM_EOF_RETURN: i32 = 130;
const TLS1_2_VERSION: i64 = 0x0303;
const TLS1_3_VERSION: i64 = 0x0304;
const SSL_OP_NO_COMPRESSION: u64 = 1 << 17;
const SSL_OP_SERVER_PREFERENCE: u64 = 1 << 22;
const SSL_OP_NO_RENEGOTIATION: u64 = 1 << 30;
const SSL_MODE_RELEASE_BUFFERS: i64 = 0x10;
const SSL_VERIFY_NONE: i32 = 0;
const SSL_VERIFY_PEER: i32 = 1;
const SSL_VERIFY_FAIL_IF_NO_PEER_CERT: i32 = 2;
const SSL_ERROR_WANT_READ: i32 = 2;
const SSL_ERROR_WANT_WRITE: i32 = 3;
const SSL_ERROR_ZERO_RETURN: i32 = 6;
const OPENSSL_NPN_NEGOTIATED: i32 = 1;
const SSL_TLSEXT_ERR_OK: i32 = 0;
const SSL_TLSEXT_ERR_ALERT_FATAL: i32 = 2;
const SSL_TLSEXT_ERR_NOACK: i32 = 3;
const TLSEXT_NAMETYPE_HOST_NAME: i32 = 0;
const CRYPTO_EX_INDEX_SSL_CTX: i32 = 1;
const DANE_FLAG_NO_DANE_EE_NAMECHECKS: u64 = 1;
const ERR_LIB_PEM: u64 = 9;
const PEM_R_NO_START_LINE: u64 = 108;
const ERR_SYSTEM_FLAG: u64 = 0x80000000;

const INT32_MAX: usize = 2147483647;

// ── Helpers ─────────────────────────────────────────────────────────────────────────────────────────────────

/// The length of the C string at `text`.
/// Safety: `text` points to a NUL-terminated string.
unsafe fn cLength(text: *CChar) -> usize {
    let bytes = text as *u8;
    var n: usize = 0;
    while (bytes.add(n).read() != 0) {
        n += 1;
    }
    return n;
}

/// Copies at most `capacity` bytes of the `length` at `from` to `out`; how many it copied.
/// Safety: `from` holds `length` bytes, and `out` has room for `capacity`.
unsafe fn copyOut(from: *u8, length: usize, out: *mut u8, capacity: usize) -> usize {
    let n = if (length < capacity) length else capacity;
    if (n > 0) {
        let source = Slice.fromRaw(from, n);
        let target = SliceMut.fromRaw(out, n);
        target.copyFrom(source);
    }
    return n;
}

/// `bytes` followed by a NUL, in `into`; false when out of memory.
fn cString(bytes: Slice<u8>, into: borrow mut Vector<u8>) -> bool {
    into.clear();
    match (into.extend(bytes)) {
        Ok() => {}
        Err(_) => { return false; }
    }
    match (into.push(0)) {
        Ok() => { return true; }
        Err(_) => { return false; }
    }
}

fn lowerAscii(b: u8) -> u8 => if (b >= 0x41 && b <= 0x5a) b + 0x20 else b;

/// OpenSSL 3's ERR_GET_LIB and ERR_GET_REASON (static inline functions of err.h).
fn errorLibrary(code: u64) -> u64 => if ((code & ERR_SYSTEM_FLAG) != 0) 2 else (code >> 23) & 0xff;

fn errorReason(code: u64) -> u64 =>
    if ((code & ERR_SYSTEM_FLAG) != 0) code & 0x7fffffff else code & 0x7fffff;

/// Clears the "no more PEM blocks" error a read loop leaves at the end of its input.
/// Safety: OpenSSL's thread-local error queue.
unsafe fn clearPemEof() {
    let e = ERR_peek_last_error();
    if (errorLibrary(e) == ERR_LIB_PEM && errorReason(e) == PEM_R_NO_START_LINE) {
        ERR_clear_error();
    }
}

// ── Per-context extras: ALPN preferences and SNI children, kept in the SSL_CTX's ex_data ───────────────────────

struct SniEntry {
    /// Lowercase; `*.example.com` for a wildcard.
    name: Vector<u8>;
    /// A reference this entry owns.
    ctx: *mut void;
}

struct CtxExtra {
    alpn: Vector<u8>;
    sni: Vector<SniEntry>;
}

/// The ex_data index of the extras, plus one; 0 until the first context asks for one.
static EXTRA_INDEX: AtomicU64 = AtomicU64.constant(0);

/// OpenSSL calls this when a context with extras is freed.
/// Safety: `extra` is null or a `Box<CtxExtra>` that `extraOf` gave the context, and this runs once for it.
@callback
unsafe fn freeExtra(parent: *mut void, extra: *mut void, data: *mut void, index: i32, argl: i64, argp: *mut void) {
    if (extra.isNull()) {
        return;
    }
    let owned: Box<CtxExtra> = Box.fromRaw(extra as *mut CtxExtra);
    for (entry in owned.sni.view()) {
        SSL_CTX_free(entry.ctx);
    }
}

/// The index of the extras in a context's ex_data; -1 if OpenSSL could not make one.
/// Safety: OpenSSL is initialised.
unsafe fn extraIndex() -> i32 {
    let known = EXTRA_INDEX.load();
    if (known != 0) {
        return truncate<i32>(known - 1);
    }
    let made = CRYPTO_get_ex_new_index(CRYPTO_EX_INDEX_SSL_CTX, 0, 0 as *mut void, 0 as *void, 0 as *void, freeExtra);
    if (made < 0) {
        return -1;
    }
    // Two threads may race to make the index: the first one stored wins, and the other's index is left unused.
    return match (EXTRA_INDEX.compareExchange(0, truncate<u64>(made) + 1)) {
        Ok(_) => made,
        Err(current) => truncate<i32>(current - 1),
    };
}

/// The context's extras, made when `create` and there are none yet; null when there are none or out of memory.
/// Safety: `ctx` is a live SSL_CTX, configured by one thread at a time.
unsafe fn extraOf(ctx: *mut void, create: bool) -> *mut CtxExtra {
    let index = extraIndex();
    if (index < 0) {
        return 0 as *mut CtxExtra;
    }
    let existing = SSL_CTX_get_ex_data(ctx, index) as *mut CtxExtra;
    if (!existing.isNull() || !create) {
        return existing;
    }
    let made = match (Box.create(CtxExtra { alpn: Vector<u8>.create(), sni: Vector<SniEntry>.create() })) {
        Ok(b) => b,
        Err(_) => { return 0 as *mut CtxExtra; }
    };
    let raw = Box.intoRaw(made);
    if (SSL_CTX_set_ex_data(ctx, index, raw as *mut void) != 1) {
        let back: Box<CtxExtra> = Box.fromRaw(raw);
        return 0 as *mut CtxExtra;
    }
    return raw;
}

// ── Contexts ─────────────────────────────────────────────────────────────────────────────────────────────────

/// A new context for servers or clients: TLS 1.2 at least, no compression or renegotiation, buffers released when
/// idle; servers prefer their own cipher order and do not ask for client certificates; clients verify the peer.
/// Safety: none beyond the result's ownership: free it with `cstls_ctx_free`.
@effects(alloc)
unsafe fn cstls_ctx_new(server: i32) -> *mut void {
    if (OPENSSL_init_ssl(0, 0 as *void) == 0) {
        return 0 as *mut void;
    }
    let ctx = SSL_CTX_new(if (server != 0) TLS_server_method() else TLS_client_method());
    if (ctx.isNull()) {
        return ctx;
    }
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION, 0 as *mut void);
    SSL_CTX_set_options(ctx, SSL_OP_NO_COMPRESSION | SSL_OP_NO_RENEGOTIATION);
    // Idle connections give their record buffers back: a mail server holds many idle IMAP sessions.
    SSL_CTX_ctrl(ctx, SSL_CTRL_MODE, SSL_MODE_RELEASE_BUFFERS, 0 as *mut void);
    if (server != 0) {
        SSL_CTX_set_options(ctx, SSL_OP_SERVER_PREFERENCE);
        let sid = "cstls";
        SSL_CTX_set_session_id_context(ctx, sid.ptr, truncate<u32>(sid.length));
        SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, 0 as *void);
    } else {
        SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, 0 as *void);
    }
    return ctx;
}

/// Safety: `ctx` is a live context.
@effects()
unsafe fn cstls_ctx_up_ref(ctx: *mut void) {
    SSL_CTX_up_ref(ctx);
}

/// Safety: `ctx` is a reference the caller owns.
@effects()
unsafe fn cstls_ctx_free(ctx: *mut void) {
    SSL_CTX_free(ctx);
}

/// Sets the certificate chain (the leaf first) and its private key, both PEM.
/// Safety: `ctx` is live; `chain` and `key` hold their lengths.
@effects(alloc)
unsafe fn cstls_ctx_use_pem(ctx: *mut void, chain: *u8, chainLength: usize, key: *u8, keyLength: usize) -> i32 {
    ERR_clear_error();
    if (chainLength > INT32_MAX || keyLength > INT32_MAX) {
        return CSTLS_ERR_CONFIG;
    }
    let cb = BIO_new_mem_buf(chain as *void, truncate<i32>(chainLength));
    if (cb.isNull()) {
        return CSTLS_ERR_NOMEM;
    }
    let leaf = PEM_read_bio_X509_AUX(cb, 0 as *mut void, 0 as *void, 0 as *mut void);
    if (leaf.isNull() || SSL_CTX_use_certificate(ctx, leaf) != 1) {
        X509_free(leaf);
        BIO_free(cb);
        return CSTLS_ERR_CERT;
    }
    X509_free(leaf);
    SSL_CTX_ctrl(ctx, SSL_CTRL_CHAIN, 0, 0 as *mut void); // clear the chain
    loop {
        let extra = PEM_read_bio_X509(cb, 0 as *mut void, 0 as *void, 0 as *mut void);
        if (extra.isNull()) {
            break;
        }
        // SSL_CTX_add0_chain_cert: takes ownership on success.
        if (SSL_CTX_ctrl(ctx, SSL_CTRL_CHAIN_CERT, 0, extra) != 1) {
            X509_free(extra);
            BIO_free(cb);
            return CSTLS_ERR_CERT;
        }
    }
    clearPemEof();
    BIO_free(cb);

    let kb = BIO_new_mem_buf(key as *void, truncate<i32>(keyLength));
    if (kb.isNull()) {
        return CSTLS_ERR_NOMEM;
    }
    let pkey = PEM_read_bio_PrivateKey(kb, 0 as *mut void, 0 as *void, 0 as *mut void);
    BIO_free(kb);
    if (pkey.isNull()) {
        return CSTLS_ERR_KEY;
    }
    // Checked first: SSL_CTX_use_PrivateKey refuses a mismatched key with the same error as an unusable one.
    let cert = SSL_CTX_get0_certificate(ctx);
    if (cert.isNull() || X509_check_private_key(cert, pkey) != 1) {
        EVP_PKEY_free(pkey);
        ERR_clear_error();
        return CSTLS_ERR_KEY_MISMATCH;
    }
    let used = SSL_CTX_use_PrivateKey(ctx, pkey);
    EVP_PKEY_free(pkey);
    return if (used == 1) CSTLS_OK else CSTLS_ERR_KEY;
}

/// Safety: `ctx` is live.
@effects(alloc)
unsafe fn cstls_ctx_trust_system(ctx: *mut void) -> i32 {
    ERR_clear_error();
    return if (SSL_CTX_set_default_verify_paths(ctx) == 1) CSTLS_OK else CSTLS_ERR_TRUST;
}

/// Adds the PEM certificates in `pem` to the context's trust store; at least one is needed.
/// Safety: `ctx` is live; `pem` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_ctx_trust_pem(ctx: *mut void, pem: *u8, length: usize) -> i32 {
    ERR_clear_error();
    if (length > INT32_MAX) {
        return CSTLS_ERR_CONFIG;
    }
    let b = BIO_new_mem_buf(pem as *void, truncate<i32>(length));
    if (b.isNull()) {
        return CSTLS_ERR_NOMEM;
    }
    let store = SSL_CTX_get_cert_store(ctx);
    var added = 0;
    loop {
        let x = PEM_read_bio_X509(b, 0 as *mut void, 0 as *void, 0 as *mut void);
        if (x.isNull()) {
            break;
        }
        let ok = X509_STORE_add_cert(store, x);
        X509_free(x);
        if (ok != 1) {
            BIO_free(b);
            return CSTLS_ERR_TRUST;
        }
        added += 1;
    }
    clearPemEof();
    BIO_free(b);
    return if (added > 0) CSTLS_OK else CSTLS_ERR_TRUST;
}

/// Servers: ask for and require a client certificate; clients: verify the server (the default).
/// Safety: `ctx` is live.
@effects()
unsafe fn cstls_ctx_verify_peer(ctx: *mut void, on: i32) {
    let server = SSL_CTX_get_ssl_method(ctx) == TLS_server_method();
    var mode = SSL_VERIFY_NONE;
    if (on != 0) {
        mode = if (server) SSL_VERIFY_PEER + SSL_VERIFY_FAIL_IF_NO_PEER_CERT else SSL_VERIFY_PEER;
    }
    SSL_CTX_set_verify(ctx, mode, 0 as *void);
}

/// Safety: `ctx` is live.
@effects(alloc)
unsafe fn cstls_ctx_min_version(ctx: *mut void, version: i32) -> i32 {
    let v = if (version == 13) TLS1_3_VERSION else TLS1_2_VERSION;
    return if (SSL_CTX_ctrl(
        ctx,
        SSL_CTRL_SET_MIN_PROTO_VERSION,
        v,
        0 as *mut void,
    ) == 1) CSTLS_OK else CSTLS_ERR_CONFIG;
}

/// The server's ALPN choice: its own preference order among what the client offers (RFC 7301).
/// Safety: OpenSSL passes the client's list and the `CtxExtra` given with the callback.
@callback
unsafe fn alpnSelect(
    ssl: *mut void,
    out: *mut *u8,
    outLength: *mut u8,
    offered: *u8,
    offeredLength: u32,
    arg: *mut void,
) -> i32 {
    let extra = Ptr.toBorrow(arg as *CtxExtra);
    var selected = 0 as *mut u8;
    let preferred = extra.alpn.view();
    if (SSL_select_next_proto(
        borrow mut selected as *mut *mut u8,
        outLength,
        preferred.ptr,
        truncate<u32>(preferred.length),
        offered,
        offeredLength,
    ) == OPENSSL_NPN_NEGOTIATED) {
        out.write(selected as *u8);
        return SSL_TLSEXT_ERR_OK;
    }
    return SSL_TLSEXT_ERR_ALERT_FATAL; // RFC 7301 §3.2: no_application_protocol
}

/// The ALPN protocols, in wire form (length-prefixed names): for a client, those it offers; for a server, its
/// preference order.
/// Safety: `ctx` is live and configured by one thread; `wire` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_ctx_set_alpn(ctx: *mut void, wire: *u8, length: usize) -> i32 {
    if (length == 0 || length > 0xffff) {
        return CSTLS_ERR_CONFIG;
    }
    if (SSL_CTX_get_ssl_method(ctx) != TLS_server_method()) {
        return if (SSL_CTX_set_alpn_protos(ctx, wire, truncate<u32>(length)) == 0) CSTLS_OK else CSTLS_ERR_NOMEM;
    }
    let raw = extraOf(ctx, true);
    if (raw.isNull()) {
        return CSTLS_ERR_NOMEM;
    }
    let extra = Ptr.toBorrowMut(raw);
    extra.alpn.clear();
    match (extra.alpn.extend(Slice.fromRaw(wire, length))) {
        Ok() => {}
        Err(_) => { return CSTLS_ERR_NOMEM; }
    }
    SSL_CTX_set_alpn_select_cb(ctx, alpnSelect, raw as *mut void);
    return CSTLS_OK;
}

fn sameIgnoringCase(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (lowerAscii(a[i]) != lowerAscii(b[i])) {
            return false;
        }
    }
    return true;
}

/// Whether `name` (from the client) matches `pattern` (lowercase), any case; a wildcard covers exactly one leftmost
/// label.
fn nameMatches(pattern: Slice<u8>, name: Slice<u8>) -> bool {
    if (pattern.length >= 2 && pattern[0] == 0x2a && pattern[1] == 0x2e) {
        var dot: usize = 0;
        while (dot < name.length && name[dot] != 0x2e) {
            dot += 1;
        }
        if (dot == 0 || dot >= name.length) {
            return false;
        }
        return sameIgnoringCase(pattern[2..], name[(dot + 1)..]);
    }
    return sameIgnoringCase(pattern, name);
}

/// The SNI entry for `name`: exact names before wildcards; null when none matches.
fn sniFor(extra: borrow CtxExtra, name: Slice<u8>) -> *mut void {
    for (entry in extra.sni.view()) {
        let pattern = entry.name.view();
        if ((pattern.length == 0 || pattern[0] != 0x2a) && nameMatches(pattern, name)) {
            return entry.ctx;
        }
    }
    for (entry in extra.sni.view()) {
        let pattern = entry.name.view();
        if (pattern.length > 0 && pattern[0] == 0x2a && nameMatches(pattern, name)) {
            return entry.ctx;
        }
    }
    return 0 as *mut void;
}

/// The server's SNI choice: the context of the name the client asked for; an unknown name keeps the default
/// certificate.
/// Safety: OpenSSL passes the connection and the `CtxExtra` given with the callback.
@callback
unsafe fn sniSelect(ssl: *mut void, alert: *mut i32, arg: *mut void) -> i32 {
    let extra = Ptr.toBorrow(arg as *CtxExtra);
    let text = SSL_get_servername(ssl, TLSEXT_NAMETYPE_HOST_NAME);
    if ((text as *void).isNull()) {
        return SSL_TLSEXT_ERR_NOACK;
    }
    let chosen = sniFor(extra, Slice.fromRaw(text as *u8, cLength(text)));
    if (!chosen.isNull()) {
        SSL_set_SSL_CTX(ssl, chosen);
    }
    return SSL_TLSEXT_ERR_OK;
}

/// Serves `child`'s certificate to clients that ask for `name` (an exact name, or `*.example.com`).
/// Safety: `ctx` and `child` are live, `ctx` configured by one thread; `name` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_ctx_add_sni(ctx: *mut void, name: *u8, length: usize, child: *mut void) -> i32 {
    if (length == 0 || length > 253) {
        return CSTLS_ERR_CONFIG;
    }
    let raw = extraOf(ctx, true);
    if (raw.isNull()) {
        return CSTLS_ERR_NOMEM;
    }
    var lowered = Vector<u8>.create();
    for (b in Slice.fromRaw(name, length)) {
        match (lowered.push(lowerAscii(b))) {
            Ok() => {}
            Err(_) => { return CSTLS_ERR_NOMEM; }
        }
    }
    let extra = Ptr.toBorrowMut(raw);
    match (extra.sni.push(SniEntry { name: lowered, ctx: child })) {
        Ok() => {}
        Err(_) => { return CSTLS_ERR_NOMEM; }
    }
    SSL_CTX_up_ref(child);
    SSL_CTX_callback_ctrl(ctx, SSL_CTRL_SET_TLSEXT_SERVERNAME_CB, sniSelect);
    SSL_CTX_ctrl(ctx, SSL_CTRL_SET_TLSEXT_SERVERNAME_ARG, 0, raw as *mut void);
    return CSTLS_OK;
}

// ── Holders: a replaceable context, for certificate hot reload ─────────────────────────────────────────────────

struct Holder {
    /// A spin lock around reading and replacing `ctx`: held only for a reference count's change.
    busy: AtomicBool;
    /// The `SSL_CTX *`, a reference the holder owns.
    ctx: AtomicUSize;
}

fn acquire(h: borrow Holder) {
    loop {
        match (h.busy.compareExchange(false, true)) {
            Ok(_) => { return; }
            Err(_) => {}
        }
    }
}

/// Safety: `ctx` is live; the result is freed with `cstls_holder_free`.
@effects(alloc)
unsafe fn cstls_holder_new(ctx: *mut void) -> *mut void {
    let made = match (Box.create(Holder { busy: AtomicBool.create(false), ctx: AtomicUSize.create(ctx as usize) })) {
        Ok(b) => b,
        Err(_) => { return 0 as *mut void; }
    };
    SSL_CTX_up_ref(ctx);
    return Box.intoRaw(made) as *mut void;
}

/// The current context, as a new reference the caller owns.
/// Safety: `holder` is live.
@effects()
unsafe fn cstls_holder_get(holder: *mut void) -> *mut void {
    let h = Ptr.toBorrow(holder as *Holder);
    acquire(h);
    let ctx = h.ctx.load() as *mut void;
    SSL_CTX_up_ref(ctx);
    h.busy.store(false);
    return ctx;
}

/// Replaces the context; connections made from the old one keep their own references.
/// Safety: `holder` and `ctx` are live.
@effects()
unsafe fn cstls_holder_set(holder: *mut void, ctx: *mut void) {
    let h = Ptr.toBorrow(holder as *Holder);
    SSL_CTX_up_ref(ctx);
    acquire(h);
    let old = h.ctx.swap(ctx as usize) as *mut void;
    h.busy.store(false);
    SSL_CTX_free(old);
}

/// Safety: `holder` came from `cstls_holder_new`, and nothing uses it any more.
@effects()
unsafe fn cstls_holder_free(holder: *mut void) {
    let owned: Box<Holder> = Box.fromRaw(holder as *mut Holder);
    SSL_CTX_free(owned.ctx.load() as *mut void);
}

// ── Connections ──────────────────────────────────────────────────────────────────────────────────────────────

struct Conn {
    ssl: *mut void;
    /// The memory BIOs: what the peer sent (fed in), and what to send to it (drained). The SSL owns both.
    input: *mut void;
    output: *mut void;
}

/// Whether `text` is an IPv4 or IPv6 address literal (SNI is never sent for one, RFC 6066 §3).
fn isIpLiteral(text: Slice<u8>) -> bool => match (StringView.fromUtf8(text)) {
    Some(s) => SocketAddresses.parseIp(s, 0) != null,
    null => false,
};

/// A connection over two memory BIOs, server or client. A client sends `host` as its SNI name (unless it is an
/// address) and, with `verifyHost`, checks the certificate against it.
/// Safety: `ctx` is live; `host` holds `hostLength` bytes; the result is freed with `cstls_conn_free`.
@effects(alloc)
unsafe fn cstls_conn_new(ctx: *mut void, server: i32, host: *u8, hostLength: usize, verifyHost: i32) -> *mut void {
    ERR_clear_error();
    if (hostLength >= 256) {
        return 0 as *mut void;
    }
    let ssl = SSL_new(ctx);
    let input = BIO_new(BIO_s_mem());
    let output = BIO_new(BIO_s_mem());
    if (ssl.isNull() || input.isNull() || output.isNull()) {
        SSL_free(ssl);
        BIO_free(input);
        BIO_free(output);
        return 0 as *mut void;
    }
    BIO_ctrl(input, BIO_C_SET_BUF_MEM_EOF_RETURN, -1, 0 as *mut void); // empty means "wait for more", not the end
    BIO_ctrl(output, BIO_C_SET_BUF_MEM_EOF_RETURN, -1, 0 as *mut void);
    SSL_set_bio(ssl, input, output); // the SSL owns both BIOs from here
    let made = match (Box.create(Conn { ssl: ssl, input: input, output: output })) {
        Ok(b) => b,
        Err(_) => {
            SSL_free(ssl);
            return 0 as *mut void;
        }
    };
    if (server != 0) {
        SSL_set_accept_state(ssl);
        return Box.intoRaw(made) as *mut void;
    }
    SSL_set_connect_state(ssl);
    if (hostLength > 0) {
        var name = Vector<u8>.create();
        if (!cString(Slice.fromRaw(host, hostLength), mut name)) {
            SSL_free(ssl);
            return 0 as *mut void;
        }
        let isIp = isIpLiteral(Slice.fromRaw(host, hostLength));
        let text = name.view().ptr as *CChar;
        var ok = true;
        if (!isIp) {
            ok = SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_HOST_NAME as i64, text as *mut void) == 1;
        }
        if (ok && verifyHost != 0) {
            ok = if (isIp) X509_VERIFY_PARAM_set1_ip_asc(
                SSL_get0_param(ssl),
                text,
            ) == 1 else SSL_set1_host(ssl, text) == 1;
        }
        if (!ok) {
            SSL_free(ssl);
            return 0 as *mut void;
        }
    }
    return Box.intoRaw(made) as *mut void;
}

/// The connection behind a handle from `cstls_conn_new`.
/// Safety: `conn` is live.
unsafe fn connOf(conn: *mut void) -> Conn => (conn as *Conn).read();

/// Safety: `conn` came from `cstls_conn_new`, and nothing uses it any more.
@effects()
unsafe fn cstls_conn_free(conn: *mut void) {
    let owned: Box<Conn> = Box.fromRaw(conn as *mut Conn);
    SSL_free(owned.ssl);
}

/// 1 when the handshake is done, 0 when it waits for the peer, -1 when it failed.
/// Safety: `conn` is live.
@effects(alloc)
unsafe fn cstls_conn_handshake(conn: *mut void) -> i32 {
    let ssl = connOf(conn).ssl;
    ERR_clear_error();
    let r = SSL_do_handshake(ssl);
    if (r == 1) {
        return 1;
    }
    let e = SSL_get_error(ssl, r);
    return if (e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE) 0 else -1;
}

/// Bytes received from the peer; how many were taken, or -1.
/// Safety: `conn` is live; `bytes` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_conn_feed(conn: *mut void, bytes: *u8, length: usize) -> i64 {
    if (length == 0) {
        return 0;
    }
    let n = BIO_write(connOf(conn).input, bytes as *void, truncate<i32>(if (length > INT32_MAX) INT32_MAX else length));
    return if (n < 0) -1 else n as i64;
}

/// Safety: `conn` is live.
@effects()
unsafe fn cstls_conn_pending_out(conn: *mut void) -> usize => BIO_ctrl_pending(connOf(conn).output);

/// Takes up to `capacity` bytes to send to the peer.
/// Safety: `conn` is live; `out` has room for `capacity` bytes.
@effects()
unsafe fn cstls_conn_drain(conn: *mut void, out: *mut u8, capacity: usize) -> i64 {
    let n = BIO_read(
        connOf(conn).output,
        out as *mut void,
        truncate<i32>(if (capacity > INT32_MAX) INT32_MAX else capacity),
    );
    return if (n < 0) 0 else n as i64;
}

/// Application data: bytes read, 0 at the peer's close_notify, -1 when more input is needed, -2 on an error.
/// Safety: `conn` is live; `out` has room for `capacity` bytes.
@effects(alloc)
unsafe fn cstls_conn_read(conn: *mut void, out: *mut u8, capacity: usize) -> i64 {
    let ssl = connOf(conn).ssl;
    ERR_clear_error();
    var n: usize = 0;
    if (SSL_read_ex(ssl, out as *mut void, capacity, borrow mut n as *mut usize) == 1) {
        return truncate<i64>(n);
    }
    let e = SSL_get_error(ssl, 0);
    if (e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE) {
        return -1;
    }
    return if (e == SSL_ERROR_ZERO_RETURN) 0 else -2;
}

/// Application data to send: bytes taken, -1 when the connection must move bytes first, -2 on an error.
/// Safety: `conn` is live; `bytes` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_conn_write(conn: *mut void, bytes: *u8, length: usize) -> i64 {
    let ssl = connOf(conn).ssl;
    ERR_clear_error();
    var n: usize = 0;
    if (SSL_write_ex(ssl, bytes as *void, length, borrow mut n as *mut usize) == 1) {
        return truncate<i64>(n);
    }
    let e = SSL_get_error(ssl, 0);
    return if (e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE) -1 else -2;
}

/// Safety: `conn` is live.
@effects(alloc)
unsafe fn cstls_conn_shutdown(conn: *mut void) -> i32 {
    ERR_clear_error();
    let r = SSL_shutdown(connOf(conn).ssl);
    return if (r < 0) -1 else r;
}

/// Safety: `conn` is live.
@effects()
unsafe fn cstls_conn_version(conn: *mut void) -> i32 => SSL_version(connOf(conn).ssl);

/// The negotiated ALPN protocol into `out`; its full length (0: none).
/// Safety: `conn` is live; `out` has room for `capacity` bytes.
@effects()
unsafe fn cstls_conn_alpn(conn: *mut void, out: *mut u8, capacity: usize) -> usize {
    var data = 0 as *u8;
    var length: u32 = 0;
    SSL_get0_alpn_selected(connOf(conn).ssl, borrow mut data as *mut *u8, borrow mut length as *mut u32);
    if (length > 0) {
        copyOut(data, length as usize, out, capacity);
    }
    return length as usize;
}

/// The SNI name the client sent into `out`; its full length (0: none).
/// Safety: `conn` is live; `out` has room for `capacity` bytes.
@effects()
unsafe fn cstls_conn_server_name(conn: *mut void, out: *mut u8, capacity: usize) -> usize {
    let name = SSL_get_servername(connOf(conn).ssl, TLSEXT_NAMETYPE_HOST_NAME);
    if ((name as *void).isNull()) {
        return 0;
    }
    let length = cLength(name);
    copyOut(name as *u8, length, out, capacity);
    return length;
}

/// Safety: `conn` is live.
@effects()
unsafe fn cstls_conn_verify_result(conn: *mut void) -> i64 => SSL_get_verify_result(connOf(conn).ssl);

/// Safety: `conn` is live.
@effects()
unsafe fn cstls_conn_has_peer_certificate(conn: *mut void) -> i32 =>
    if (SSL_get0_peer_certificate(connOf(conn).ssl).isNull()) 0 else 1;

// ── DANE (RFC 6698; RFC 7672 for SMTP) ───────────────────────────────────────────────────────────────────────

/// Lets the context's connections use DANE. Once, when the context is made: it changes the context, which other
/// threads' connections may be using afterwards.
/// Safety: `ctx` is live.
@effects()
unsafe fn cstls_ctx_dane_enable(ctx: *mut void) -> i32 {
    ERR_clear_error();
    return if (SSL_CTX_dane_enable(ctx) > 0) CSTLS_OK else CSTLS_ERR_CONFIG;
}

/// Makes a client connection, before its handshake, authenticate the server by the TLSA records added next, with
/// `base` (the TLSA base domain, an MX host's name) as the reference identifier for DANE-TA. DANE-EE matches skip
/// name checks (RFC 7672 §3.1.1), and the peer must verify: a chain no record matches fails the handshake with
/// X509_V_ERR_DANE_NO_MATCH. The context must have had cstls_ctx_dane_enable.
/// Safety: `conn` is live; `base` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_conn_dane_enable(conn: *mut void, base: *u8, length: usize) -> i32 {
    if (length == 0 || length > 253) {
        return CSTLS_ERR_CONFIG;
    }
    var name = Vector<u8>.create();
    if (!cString(Slice.fromRaw(base, length), mut name)) {
        return CSTLS_ERR_NOMEM;
    }
    let ssl = connOf(conn).ssl;
    ERR_clear_error();
    if (SSL_dane_enable(ssl, name.view().ptr as *CChar) <= 0) {
        return CSTLS_ERR_CONFIG;
    }
    SSL_dane_set_flags(ssl, DANE_FLAG_NO_DANE_EE_NAMECHECKS);
    SSL_set_verify(ssl, SSL_VERIFY_PEER, 0 as *void);
    return CSTLS_OK;
}

/// Adds one TLSA record: 1 when OpenSSL can use it, 0 when it is unusable (an unknown usage, selector or matching
/// type, or a digest of the wrong length), -1 on failure.
/// Safety: `conn` is live; `data` holds `length` bytes.
@effects(alloc)
unsafe fn cstls_conn_dane_add(
    conn: *mut void,
    usage: i32,
    selector: i32,
    matching: i32,
    data: *u8,
    length: usize,
) -> i32 {
    if (usage < 0 || usage > 255 || selector < 0 || selector > 255 || matching < 0 || matching > 255) {
        return 0;
    }
    ERR_clear_error();
    let r = SSL_dane_tlsa_add(
        connOf(conn).ssl,
        truncate<u8>(usage),
        truncate<u8>(selector),
        truncate<u8>(matching),
        data,
        length,
    );
    if (r < 0) {
        ERR_clear_error();
    }
    return if (r > 0) 1 else if (r == 0) 0 else -1;
}

/// After a handshake: the depth of the certificate a TLSA record matched (0 for the server's own), or -1 when DANE
/// did not authenticate the peer.
/// Safety: `conn` is live.
@effects()
unsafe fn cstls_conn_dane_depth(conn: *mut void) -> i32 =>
    SSL_get0_dane_authority(connOf(conn).ssl, 0 as *mut void, 0 as *mut void);

// ── Errors ───────────────────────────────────────────────────────────────────────────────────────────────────

/// The last error on this thread's OpenSSL queue (0: none), which it empties.
/// Safety: OpenSSL's thread-local error queue.
@effects()
unsafe fn cstls_take_error() -> u64 {
    var last: u64 = 0;
    loop {
        let e = ERR_get_error();
        if (e == 0) {
            return last;
        }
        last = e;
    }
}

/// OpenSSL's text for an error code into `out`; its length.
/// Safety: `out` has room for `capacity` bytes.
@effects()
unsafe fn cstls_error_text(code: u64, out: *mut u8, capacity: usize) -> usize {
    if (capacity == 0) {
        return 0;
    }
    ERR_error_string_n(code, out as *mut CChar, capacity);
    return cLength(out as *CChar);
}

/// OpenSSL's text for a certificate verification result into `out`; its length.
/// Safety: `out` has room for `capacity` bytes.
@effects()
unsafe fn cstls_verify_text(code: i64, out: *mut u8, capacity: usize) -> usize {
    let text = X509_verify_cert_error_string(code);
    return copyOut(text as *u8, cLength(text), out, capacity);
}
