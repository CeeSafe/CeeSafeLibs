@test
fn theSmallestVersionAndADrawnMaskWhenLeftToChoose() -> Result<void, TestFailure> {
    let text: StringView = "MRVL1:968292385607792169076553501160296942588563605209549570124755";
    let expected: [StringView; 8] = [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ];
    let qr = match (QrCode.encode(text.bytes(), Ecc.Medium)) {
        Some(q) => q,
        null => { return Check.fail("not encoded"); }
    };
    Check.isTrue(qr.version == 5 && qr.mask < 8, "version 5")?;
    Check.isTrue(same(qr, expected[qr.mask as usize]), "the chosen mask's modules")?;
    let tooMuch = made(3000);
    return Check.isTrue(QrCode.encode(tooMuch.view(), Ecc.Low) == null, "too much for version 40");
}
