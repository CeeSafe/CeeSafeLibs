// Every module against Python's qrcode (the same data, level, version and mask), packed row by row, high bit first.

fn nibble(c: u8) -> u8 {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    return c - 'a' + 10;
}

/// The code's modules packed as the expected hex is, and compared with it.
fn same(qr: borrow QrCode, hex: StringView) -> bool {
    let total = qr.size * qr.size;
    if (hex.length != (total + 7) / 8 * 2) {
        return false;
    }
    for (i in 0usize..total) {
        let byte = nibble(hex[i / 8 * 2]) * 16 + nibble(hex[i / 8 * 2 + 1]);
        let want = ((byte >> truncate<u8>(7 - i % 8)) & 1) != 0;
        if (qr.dark(i % qr.size, i / qr.size) != want) {
            return false;
        }
    }
    return true;
}

fn made(n: usize) -> Vector<u8> {
    var v = Vector<u8>.withCapacity(n)!;
    for (i in 0..n) {
        v.push(truncate<u8>((i * 7 + 3) % 256))!;
    }
    return v;
}

@test
fn theSafetyQrUnderEachMask() -> Result<void, TestFailure> {
    let text: StringView = "MRVL1:968292385607792169076553501160296942588563605209549570124755";
    let expected: [StringView; 8] = [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ];
    for (mask in 0usize..8) {
        let qr = match (QrCode.encodeWith(text.bytes(), Ecc.Medium, 1, truncate<i32>(mask))) {
            Some(q) => q,
            null => { return Check.fail("not encoded"); }
        };
        Check.isTrue(qr.version == 5 && qr.size == 37 && qr.mask == truncate<u32>(mask), "version 5, the mask")?;
        Check.isTrue(same(qr, expected[mask]), "every module")?;
    }
    return Ok();
}

@test
fn hello() -> Result<void, TestFailure> {
    let text: StringView = "hello";
    let data = text.bytes();
    let qr = match (QrCode.encodeWith(data, Ecc.Low, 1, 3)) {
        Some(q) => q,
        null => { return Check.fail("not encoded"); }
    };
    Check.isTrue(qr.version == 1, "version 1")?;
    return Check.isTrue(
        same(
            qr,
            "febbfc11906eb4bb7595dba92ec13d07faafe00300f2fcedc6f37cac0658e7a33890804913f9e4104c3eba4ffdd697aea2c9050b1fea5200",
        ),
        "every module",
    );
}

@test
fn aHundredBytesQuartile() -> Result<void, TestFailure> {
    let bytes = made(100);
    let data = bytes.view();
    let qr = match (QrCode.encodeWith(data, Ecc.Quartile, 1, 5)) {
        Some(q) => q,
        null => { return Check.fail("not encoded"); }
    };
    Check.isTrue(qr.version == 8, "version 8")?;
    return Check.isTrue(
        same(
            qr,
            "",
        ),
        "every module",
    );
}

@test
fn fiveHundredBytesHigh() -> Result<void, TestFailure> {
    let bytes = made(500);
    let data = bytes.view();
    let qr = match (QrCode.encodeWith(data, Ecc.High, 1, 6)) {
        Some(q) => q,
        null => { return Check.fail("not encoded"); }
    };
    Check.isTrue(qr.version == 24, "version 24")?;
    return Check.isTrue(
        same(
            qr,
            "",
        ),
        "every module",
    );
}

