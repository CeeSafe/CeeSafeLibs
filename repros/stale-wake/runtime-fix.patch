@@ -2236,12 +2236,17 @@
         bool done = t->scope == NULL ? t->resume.root(t->frame) : t->resume.child(t->frame, t->scope);
         cee_exec.current = NULL;
         if (!done) {
-            if (ceesafe_atomic_swap_u64(&t->woken, 0u) != 0u) {
