// SHA-256 (FIPS 180-4), HMAC-SHA-256 (RFC 2104) and PBKDF2-HMAC-SHA-256 (RFC 8018 §5.2), in CeeSafe.
//
// Everything here is a Copy value with no allocation: a hasher is about 108 bytes on the stack, so a keyed HMAC state
// can be copied instead of recomputed (PBKDF2 does this once per iteration).

/// The size of a SHA-256 digest, in bytes.
public const DIGEST_LENGTH: usize = 32;

/// The size of a SHA-256 block, in bytes.
public const BLOCK_LENGTH: usize = 64;

const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const INITIAL: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// Runs the compression function over one 64-byte block.
fn compress(state: borrow mut [u32; 8], block: Slice<u8>) {
    var w = [0u32; 64];
    for (t in 0..16) {
        w[t] = block.readBE<u32>(t * 4);
    }
    for (t in 16..64) {
        let x = w[t - 15];
        let y = w[t - 2];
        let s0 = x.rotateRight(7) ^ x.rotateRight(18) ^ (x >> 3);
        let s1 = y.rotateRight(17) ^ y.rotateRight(19) ^ (y >> 10);
        w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1);
    }
    var a = state[0];
    var b = state[1];
    var c = state[2];
    var d = state[3];
    var e = state[4];
    var f = state[5];
    var g = state[6];
    var h = state[7];
    for (t in 0..64) {
        let s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25);
        let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);
        let t1 = h.wrappingAdd(s1).wrappingAdd(ch).wrappingAdd(K[t]).wrappingAdd(w[t]);
        let s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0.wrappingAdd(maj);
        h = g;
        g = f;
        f = e;
        e = d.wrappingAdd(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrappingAdd(t2);
    }
    state[0] = state[0].wrappingAdd(a);
    state[1] = state[1].wrappingAdd(b);
    state[2] = state[2].wrappingAdd(c);
    state[3] = state[3].wrappingAdd(d);
    state[4] = state[4].wrappingAdd(e);
    state[5] = state[5].wrappingAdd(f);
    state[6] = state[6].wrappingAdd(g);
    state[7] = state[7].wrappingAdd(h);
}

/// An incremental SHA-256 hasher: `create`, any number of `update`s, then `finish`.
public struct Sha256 {
    private state: [u32; 8];
    private block: [u8; 64];
    private used: usize;
    private total: u64;

    /// A hasher that has seen no input.
    public fn create() -> Sha256 => Sha256 { state: INITIAL, block: [0u8; 64], used: 0, total: 0 };

    /// The digest of `data`, in one call.
    public fn hash(data: Slice<u8>) -> [u8; 32] {
        var h = Sha256.create();
        h.update(data);
        return h.finish();
    }

    /// Adds `data` to the input.
    public fn update(borrow mut this, data: Slice<u8>) {
        this.total = this.total.wrappingAdd(data.length as u64);
        var at: usize = 0;
        if (this.used > 0) {
            let room = BLOCK_LENGTH - this.used;
            let n = if (data.length < room) data.length else room;
            this.block[this.used..this.used + n].copyFrom(data[0..n]);
            this.used += n;
            at = n;
            if (this.used < BLOCK_LENGTH) {
                return;
            }
            let full = this.block;
            compress(mut this.state, full[..]);
            this.used = 0;
        }
        while (data.length - at >= BLOCK_LENGTH) {
            compress(mut this.state, data[at..at + BLOCK_LENGTH]);
            at += BLOCK_LENGTH;
        }
        let rest = data.length - at;
        if (rest > 0) {
            this.block[0..rest].copyFrom(data[at..]);
            this.used = rest;
        }
    }

    /// The digest of everything added. The hasher is consumed; copy it first to keep going.
    public fn finish(this) -> [u8; 32] {
        var h = this;
        let bits = h.total.wrappingMul(8);
        h.block[h.used] = 0x80;
        h.used += 1;
        if (h.used > BLOCK_LENGTH - 8) {
            h.block[h.used..].fill(0);
            let full = h.block;
            compress(mut h.state, full[..]);
            h.used = 0;
        }
        h.block[h.used..BLOCK_LENGTH - 8].fill(0);
        h.block[..].writeBE(BLOCK_LENGTH - 8, bits);
        let last = h.block;
        compress(mut h.state, last[..]);
        var out = [0u8; 32];
        for (i in 0..8) {
            out[..].writeBE(i * 4, h.state[i]);
        }
        return out;
    }
}

/// HMAC-SHA-256 (RFC 2104): `create(key)`, `update`s, then `finish`. A keyed value can be copied and reused for
/// several messages under the same key.
public struct HmacSha256 {
    private inner: Sha256;
    private outer: Sha256;

    /// An HMAC keyed with `key` (of any length; a key longer than a block is hashed first).
    public fn create(key: Slice<u8>) -> HmacSha256 {
        var k = [0u8; 64];
        if (key.length > BLOCK_LENGTH) {
            let digest = Sha256.hash(key);
            k[0..DIGEST_LENGTH].copyFrom(digest[..]);
        } else {
            k[0..key.length].copyFrom(key);
        }
        var ipad = [0u8; 64];
        var opad = [0u8; 64];
        for (i in 0..BLOCK_LENGTH) {
            ipad[i] = k[i] ^ 0x36;
            opad[i] = k[i] ^ 0x5c;
        }
        var inner = Sha256.create();
        inner.update(ipad[..]);
        var outer = Sha256.create();
        outer.update(opad[..]);
        return HmacSha256 { inner: inner, outer: outer };
    }

    /// The MAC of `data` under `key`, in one call.
    public fn mac(key: Slice<u8>, data: Slice<u8>) -> [u8; 32] {
        var m = HmacSha256.create(key);
        m.update(data);
        return m.finish();
    }

    /// Adds `data` to the message.
    public fn update(borrow mut this, data: Slice<u8>) {
        this.inner.update(data);
    }

    /// The MAC of everything added.
    public fn finish(this) -> [u8; 32] {
        let innerDigest = this.inner.finish();
        var outer = this.outer;
        outer.update(innerDigest[..]);
        return outer.finish();
    }
}

/// PBKDF2 with HMAC-SHA-256 (RFC 8018 §5.2): fills `out` with key material derived from `password` and `salt`
/// through `iterations` rounds (at least 1; 0 is treated as 1). `out` may have any length.
public fn pbkdf2(password: Slice<u8>, salt: Slice<u8>, iterations: u32, out: SliceMut<u8>) {
    let keyed = HmacSha256.create(password);
    var done: usize = 0;
    var blockIndex: u32 = 1;
    while (done < out.length) {
        var counter = [0u8; 4];
        counter[..].writeBE(0, blockIndex);
        var first = keyed;
        first.update(salt);
        first.update(counter[..]);
        var u = first.finish();
        var t = u;
        var round: u32 = 1;
        while (round < iterations) {
            var next = keyed;
            next.update(u[..]);
            u = next.finish();
            for (j in 0..DIGEST_LENGTH) {
                t[j] = t[j] ^ u[j];
            }
            round += 1;
        }
        let remaining = out.length - done;
        let n = if (remaining < DIGEST_LENGTH) remaining else DIGEST_LENGTH;
        out[done..done + n].copyFrom(t[0..n]);
        done += n;
        blockIndex += 1;
    }
}

/// Compares two byte strings in time that depends only on their lengths, for checking MACs and proofs.
public fn constantTimeEqual(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    var diff: u8 = 0;
    for (i in 0..a.length) {
        diff = diff | (a[i] ^ b[i]);
    }
    return diff == 0;
}
