// Known-answer tests. Expected values come from Python's hashlib/hmac (FIPS 180-4 and RFC 4231 vectors among them), so
// they do not depend on this implementation.

fn nibble(c: u8) -> u8 {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    return c - 'a' + 10;
}

fn expectDigest(digest: [u8; 64], hex: StringView) -> Result<void, TestFailure> {
    var expected = [0u8; 64];
    Check.equalU64(128, hex.length as u64)?;
    for (i in 0usize..64) {
        expected[i] = nibble(hex[i * 2]) * 16 + nibble(hex[i * 2 + 1]);
    }
    return Check.equalBytes(expected[..], digest[..]);
}

fn repeated(byte: u8, count: usize) -> Vector<u8> {
    var v = Vector<u8>.withCapacity(count)!;
    for (i in 0..count) {
        v.push(byte)!;
    }
    return v;
}

@test
fn empty() -> Result<void, TestFailure> {
    let text: StringView = "";
    return expectDigest(Sha512.hash(text.bytes()), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
}

@test
fn abc() -> Result<void, TestFailure> {
    let text: StringView = "abc";
    return expectDigest(Sha512.hash(text.bytes()), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
}

@test
fn twoBlocks() -> Result<void, TestFailure> {
    let text: StringView = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    return expectDigest(Sha512.hash(text.bytes()), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
}

@test
fn length111InPieces() -> Result<void, TestFailure> {
    let data = repeated(0x61, 111);
    expectDigest(Sha512.hash(data.view()), "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2")?;
    var s = Sha512.create();
    var at: usize = 0;
    while (at < data.length) {
        let step: usize = if (data.length - at < 7) data.length - at else 7;
        s.update(data.view()[at..at + step]);
        at += step;
    }
    return expectDigest(s.finish(), "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
}

