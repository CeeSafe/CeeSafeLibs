@test
fn hmacRfc4231Case1() -> Result<void, TestFailure> {
    let key = repeated(0x0b, 20);
    let data: StringView = "Hi There";
    return expectDigest(HmacSha512.mac(key.view(), data.bytes()), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854");
}

@test
fn hmacKeyLongerThanABlock() -> Result<void, TestFailure> {
    let key = repeated(0xaa, 131);
    let data: StringView = "Test Using Larger Than Block-Size Key - Hash Key First";
    return expectDigest(HmacSha512.mac(key.view(), data.bytes()), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598");
}
