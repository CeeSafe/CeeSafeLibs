// SHA-512 (FIPS 180-4) and HMAC-SHA-512 (RFC 2104), in CeeSafe: sha256's sibling, laid out the same way.
//
// Everything here is a Copy value with no allocation: a hasher is about 200 bytes on the stack.

/// The size of a SHA-512 digest, in bytes.
public const DIGEST_LENGTH: usize = 64;

/// The size of a SHA-512 block, in bytes.
public const BLOCK_LENGTH: usize = 128;

const K: [u64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
];

const INITIAL: [u64; 8] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
];

fn rotr(x: u64, n: u64) -> u64 => (x >> n) | (x << (64 - n));

fn readU64(b: Slice<u8>, at: usize) -> u64 {
    var v: u64 = 0;
    for (i in 0usize..8) {
        v = (v << 8) | (b[at + i] as u64);
    }
    return v;
}

fn writeU64(b: SliceMut<u8>, at: usize, v: u64) {
    for (i in 0usize..8) {
        b[at + i] = truncate<u8>((v >> ((7 - i as u64) * 8)) & 0xFF);
    }
}

/// One 128-byte block into the state (FIPS 180-4 §6.4.2).
fn compress(state: borrow mut [u64; 8], block: Slice<u8>) {
    var w = [0u64; 80];
    for (t in 0usize..16) {
        w[t] = readU64(block, t * 8);
    }
    for (t in 16usize..80) {
        let s0 = rotr(w[t - 15], 1) ^ rotr(w[t - 15], 8) ^ (w[t - 15] >> 7);
        let s1 = rotr(w[t - 2], 19) ^ rotr(w[t - 2], 61) ^ (w[t - 2] >> 6);
        w[t] = w[t - 16].wrappingAdd(s0).wrappingAdd(w[t - 7]).wrappingAdd(s1);
    }
    var a = state[0];
    var b = state[1];
    var c = state[2];
    var d = state[3];
    var e = state[4];
    var f = state[5];
    var g = state[6];
    var h = state[7];
    for (t in 0usize..80) {
        let s1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41);
        let ch = (e & f) ^ (~e & g);
        let t1 = h.wrappingAdd(s1).wrappingAdd(ch).wrappingAdd(K[t]).wrappingAdd(w[t]);
        let s0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0.wrappingAdd(maj);
        h = g;
        g = f;
        f = e;
        e = d.wrappingAdd(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrappingAdd(t2);
    }
    state[0] = state[0].wrappingAdd(a);
    state[1] = state[1].wrappingAdd(b);
    state[2] = state[2].wrappingAdd(c);
    state[3] = state[3].wrappingAdd(d);
    state[4] = state[4].wrappingAdd(e);
    state[5] = state[5].wrappingAdd(f);
    state[6] = state[6].wrappingAdd(g);
    state[7] = state[7].wrappingAdd(h);
}

/// A SHA-512 hasher: `create`, `update`s, then `finish`; or `hash` for one input.
public struct Sha512 {
    private state: [u64; 8];
    private block: [u8; 128];
    private used: usize;
    private total: u64;

    /// A hasher that has seen no input.
    public fn create() -> Sha512 => Sha512 { state: INITIAL, block: [0u8; 128], used: 0, total: 0 };

    /// The digest of `data`, in one call.
    public fn hash(data: Slice<u8>) -> [u8; 64] {
        var h = Sha512.create();
        h.update(data);
        return h.finish();
    }

    /// Adds `data` to the input.
    public fn update(borrow mut this, data: Slice<u8>) {
        this.total = this.total.wrappingAdd(data.length as u64);
        var at: usize = 0;
        if (this.used > 0) {
            let room = BLOCK_LENGTH - this.used;
            let n = if (data.length < room) data.length else room;
            this.block[this.used..this.used + n].copyFrom(data[0..n]);
            this.used += n;
            at = n;
            if (this.used < BLOCK_LENGTH) {
                return;
            }
            let full = this.block;
            compress(mut this.state, full[..]);
            this.used = 0;
        }
        while (data.length - at >= BLOCK_LENGTH) {
            compress(mut this.state, data[at..at + BLOCK_LENGTH]);
            at += BLOCK_LENGTH;
        }
        let rest = data.length - at;
        if (rest > 0) {
            this.block[0..rest].copyFrom(data[at..]);
            this.used = rest;
        }
    }

    /// The digest of everything added. The hasher is consumed; copy it first to keep going.
    public fn finish(this) -> [u8; 64] {
        var h = this;
        // The length is 128 bits; an input of 2^61 bytes or more is not hashed here, so its high half is 0.
        let bits = h.total.wrappingMul(8);
        h.block[h.used] = 0x80;
        h.used += 1;
        if (h.used > BLOCK_LENGTH - 16) {
            h.block[h.used..].fill(0);
            let full = h.block;
            compress(mut h.state, full[..]);
            h.used = 0;
        }
        h.block[h.used..BLOCK_LENGTH - 8].fill(0);
        writeU64(mut h.block[..], BLOCK_LENGTH - 8, bits);
        let last = h.block;
        compress(mut h.state, last[..]);
        var out = [0u8; 64];
        for (i in 0usize..8) {
            writeU64(mut out[..], i * 8, h.state[i]);
        }
        return out;
    }
}

/// HMAC-SHA-512 (RFC 2104): `create(key)`, `update`s, then `finish`. A keyed value can be copied and reused for
/// several messages under the same key.
public struct HmacSha512 {
    private inner: Sha512;
    private outer: Sha512;

    public fn create(key: Slice<u8>) -> HmacSha512 {
        var k = [0u8; 128];
        if (key.length > BLOCK_LENGTH) {
            let d = Sha512.hash(key);
            k[0..64].copyFrom(d[..]);
        } else {
            k[0..key.length].copyFrom(key);
        }
        var ipad = [0u8; 128];
        var opad = [0u8; 128];
        for (i in 0usize..128) {
            ipad[i] = k[i] ^ 0x36;
            opad[i] = k[i] ^ 0x5c;
        }
        var inner = Sha512.create();
        inner.update(ipad[..]);
        var outer = Sha512.create();
        outer.update(opad[..]);
        return HmacSha512 { inner: inner, outer: outer };
    }

    /// The MAC of `data` under `key`, in one call.
    public fn mac(key: Slice<u8>, data: Slice<u8>) -> [u8; 64] {
        var m = HmacSha512.create(key);
        m.update(data);
        return m.finish();
    }

    public fn update(borrow mut this, data: Slice<u8>) {
        this.inner.update(data);
    }

    /// The MAC of everything added. The value is consumed; copy it first to keep going.
    public fn finish(this) -> [u8; 64] {
        let inner = this.inner.finish();
        var outer = this.outer;
        outer.update(inner[..]);
        return outer.finish();
    }
}
