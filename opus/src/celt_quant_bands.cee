// CELT's band energies decoded (libopus 1.5.2 celt/quant_bands.c, decoder side, float build; BSD).

const PRED_COEF: [f32; 4] = [0.8984375, 0.796875, 0.6484375, 0.5];
const BETA_COEF: [f32; 4] = [0.920013427734375, 0.67999267578125, 0.3699951171875, 0.20001220703125];
const BETA_INTRA: f32 = 0.149993896484375;
const SMALL_ENERGY_ICDF: [u8; 3] = [2, 1, 0];

fn unquantCoarseEnergy<region r>(start: usize, end: usize, old: SliceMut<f32>, intra: bool, dec: borrow mut RangeDecoder<r>,
    c: usize, lm: usize) {
    let model = lm * 84 + (if (intra) 42usize else 0);
    var prev = [0.0f32; 2];
    let coef: f32 = if (intra) 0.0 else PRED_COEF[lm];
    let beta: f32 = if (intra) BETA_INTRA else BETA_COEF[lm];
    let budget = truncate<i32>(dec.storageBytes() * 8);
    for (i in start..end) {
        for (ch in 0usize..c) {
            let tell = dec.tell();
            var qi: i32 = -1;
            if (budget - tell >= 15) {
                let pi = 2 * (if (i < 20) i else 20);
                qi = dec.laplace((E_PROB_MODEL[model + pi] as u32) << 7, (E_PROB_MODEL[model + pi + 1] as u32) << 6);
            } else if (budget - tell >= 2) {
                let s = dec.icdf(SMALL_ENERGY_ICDF[..], 2);
                qi = if (s == 0) 0 else if (s == 1) -1 else 1;
            } else if (budget - tell >= 1) {
                qi = if (dec.bitLogp(1)) -1 else 0;
            }
            let q = round<f32>(qi);
            let at = i + ch * NB_EBANDS;
            old[at] = celtFmax(-9.0, old[at]);
            let tmp = coef * old[at] + prev[ch] + q;
            old[at] = tmp;
            prev[ch] = prev[ch] + q - beta * q;
        }
    }
}

fn unquantFineEnergy<region r>(start: usize, end: usize, old: SliceMut<f32>, fine: borrow [i32; 21], dec: borrow mut RangeDecoder<r>,
    c: usize) {
    for (i in start..end) {
        if (fine[i] <= 0) {
            continue;
        }
        for (ch in 0usize..c) {
            let q2 = dec.bits(truncate<u32>(fine[i]));
            let offset = (round<f32>(q2) + 0.5) * round<f32>(celtShl(1, 14 - fine[i])) * (1.0 / 16384.0) - 0.5;
            old[i + ch * NB_EBANDS] += offset;
        }
    }
}

fn unquantEnergyFinalise<region r>(start: usize, end: usize, old: SliceMut<f32>, fine: borrow [i32; 21], priority: borrow [i32; 21],
    bitsLeft0: i32, dec: borrow mut RangeDecoder<r>, c: usize) {
    var bitsLeft = bitsLeft0;
    let ci = truncate<i32>(c);
    for (prio in 0..2) {
        var i = start;
        while (i < end && bitsLeft >= ci) {
            if (fine[i] >= MAX_FINE_BITS || priority[i] != prio) {
                i += 1;
                continue;
            }
            for (ch in 0usize..c) {
                let q2 = dec.bits(1);
                let offset = (round<f32>(q2) - 0.5) * round<f32>(celtShl(1, 14 - fine[i] - 1)) * (1.0 / 16384.0);
                old[i + ch * NB_EBANDS] += offset;
                bitsLeft -= 1;
            }
            i += 1;
        }
    }
}
